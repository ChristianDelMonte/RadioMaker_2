<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RadioMaker.UI.ViewModels"
             xmlns:controls="clr-namespace:RadioMaker.UI.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="RadioMaker.UI.Views.ScheduledListView"
             x:DataType="vm:ScheduledListViewModel">

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          DragDrop.AllowDrop="True">

        <!-- Barra de herramientas -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgPrimary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="0,0,0,1"
                Padding="4,2">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0">
                    <Button x:Name="NewButton" Click="OnNewClick"
                            Padding="3" Background="Transparent" BorderThickness="0"
                            ToolTip.Tip="Nueva lista de programados">
                        <materialIcons:MaterialIcon Kind="FilePlus"
                                                    Width="15" Height="15"
                                                    Foreground="{DynamicResource FgPrimary}" />
                    </Button>

                    <Button x:Name="OpenButton" Click="OnOpenClick"
                            Padding="3" Background="Transparent" BorderThickness="0"
                            ToolTip.Tip="Abrir archivo .rms">
                        <materialIcons:MaterialIcon Kind="FolderOpen"
                                                    Width="15" Height="15"
                                                    Foreground="{DynamicResource FgPrimary}" />
                    </Button>

                    <Button x:Name="SaveButton" Click="OnSaveClick"
                            Padding="3" Background="Transparent" BorderThickness="0"
                            ToolTip.Tip="Guardar">
                        <materialIcons:MaterialIcon Kind="ContentSave"
                                                    Width="15" Height="15"
                                                    Foreground="{DynamicResource FgPrimary}" />
                    </Button>

                    <Button x:Name="SaveAsButton" Click="OnSaveAsClick"
                            Padding="3" Background="Transparent" BorderThickness="0"
                            ToolTip.Tip="Guardar como...">
                        <materialIcons:MaterialIcon Kind="ContentSaveEdit"
                                                    Width="15" Height="15"
                                                    Foreground="{DynamicResource FgPrimary}" />
                    </Button>

                    <Border Width="1" Background="{DynamicResource BorderPrimary}" Margin="3,2" />

                    <Button Command="{Binding AddItemCommand}"
                            Padding="3" Background="Transparent" BorderThickness="0"
                            ToolTip.Tip="Agregar archivo suelto">
                        <materialIcons:MaterialIcon Kind="Plus"
                                                    Width="15" Height="15"
                                                    Foreground="{DynamicResource AccentText}" />
                    </Button>

                    <Button Command="{Binding AddTandaItemCommand}"
                            Padding="3" Background="Transparent" BorderThickness="0"
                            ToolTip.Tip="Agregar tanda">
                        <materialIcons:MaterialIcon Kind="FormatListBulleted"
                                                    Width="15" Height="15"
                                                    Foreground="{DynamicResource Warning}" />
                    </Button>

                    <Button Command="{Binding AddPlaylistItemCommand}"
                            Padding="3" Background="Transparent" BorderThickness="0"
                            ToolTip.Tip="Agregar playlist (.rmf)">
                        <materialIcons:MaterialIcon Kind="PlaylistMusic"
                                                    Width="15" Height="15"
                                                    Foreground="{DynamicResource Success}" />
                    </Button>

                    <Button Command="{Binding AddBlockItemCommand}"
                            Padding="3" Background="Transparent" BorderThickness="0"
                            ToolTip.Tip="Agregar bloque de programacion (playlists + tandas + archivos en secuencia)">
                        <materialIcons:MaterialIcon Kind="Layers"
                                                    Width="15" Height="15"
                                                    Foreground="{DynamicResource Accent}" />
                    </Button>

                    <Border Width="1" Background="{DynamicResource BorderPrimary}" Margin="3,2" />

                    <Button Command="{Binding RemoveSelectedItemCommand}"
                            IsEnabled="{Binding HasSelection}"
                            Padding="3" Background="Transparent" BorderThickness="0"
                            ToolTip.Tip="Quitar item seleccionado">
                        <materialIcons:MaterialIcon Kind="Close"
                                                    Width="15" Height="15"
                                                    Foreground="{DynamicResource Error}" />
                    </Button>
                </StackPanel>

                                <!-- ===== SWITCH ON/OFF ===== -->
                <ToggleSwitch Grid.Column="1"
                              IsChecked="{Binding IsEnabled}"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"
                              OnContent="Activa"
                              OffContent="Desactivada"
                              ToolTip.Tip="Si está desactivada, el motor de programación no procesa esta lista. Sus items no se disparan." />
                <controls:BusSelectorButton Grid.Column="2"
                                            DataContext="{Binding BusSelector}"
                                            VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Lista -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="0">
            <Grid RowDefinitions="Auto,Auto,*">

                <!-- Banner: solo visible si la lista esta desactivada -->
                <Border Grid.Row="0"
                        Background="{DynamicResource Warning}"
                        Padding="8,4"
                        IsVisible="{Binding !IsEnabled}">
                    <TextBlock Text="LISTA DESACTIVADA — El motor de programación no procesará esta lista hasta que la actives."
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="White"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock Grid.Row="1"
                           Text="Items programados (arrastra archivos aqui, o clic derecho sobre un item para editar)"
                           FontWeight="SemiBold"
                           FontSize="10"
                           Foreground="{DynamicResource FgSecondary}"
                           Margin="8,6,8,3" />

                <ListBox Grid.Row="2"
                         Name="ItemsListBox"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         DoubleTapped="OnItemDoubleTapped">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource BgSelected}" />
                        </Style>

                        <Style Selector="ListBoxItem StackPanel.reorder-controls">
                            <Setter Property="IsVisible" Value="False" />
                        </Style>
                        <Style Selector="ListBoxItem:selected StackPanel.reorder-controls">
                            <Setter Property="IsVisible" Value="True" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScheduledItemViewModel">
                            <Border Padding="8,6,8,8"
                                    BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="0,0,0,1"
                                    Background="{Binding RowBackground, Converter={x:Static vm:ThemeColorConverter.Instance}}"
                                    Opacity="{Binding EffectiveOpacity}"
                                    PointerPressed="OnItemPointerPressed">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Editar..." Click="OnContextEditClick" />
                                        <Separator />
                                        <MenuItem Header="Editar en RMWave..."
                                                  Click="OnContextEditInRMWaveClick"
                                                  IsEnabled="{Binding FilePath, Converter={x:Static vm:IsRmwFileConverter.Instance}}" />
                                        <Separator />
                                        <MenuItem Header="Eliminar" Click="OnContextDeleteClick" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto,Auto">

                                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                                            Background="{Binding PriorityColor, Converter={x:Static vm:ThemeColorConverter.Instance}}"
                                            Width="3" Margin="0,0,8,0"
                                            CornerRadius="2" />

                                    <StackPanel Grid.Row="0" Grid.Column="1"
                                                Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FgPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Border IsVisible="{Binding IsRmwProject}"
                                                Background="{Binding FileTypeBadgeColor, Converter={x:Static vm:ThemeColorConverter.Instance}}"
                                                CornerRadius="3" Padding="5,1"
                                                VerticalAlignment="Center"
                                                Margin="6,0,0,0">
                                            <TextBlock Text="{Binding FileTypeBadge}"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="White" />
                                        </Border>
                                        <Border Background="{Binding KindColor, Converter={x:Static vm:ThemeColorConverter.Instance}}"
                                                CornerRadius="3" Padding="4,1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KindText}"
                                                       FontSize="8" FontWeight="Bold"
                                                       Foreground="White" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                               Text="{Binding PriorityText}"
                                               FontSize="9" FontWeight="Bold"
                                               Foreground="{Binding PriorityColor, Converter={x:Static vm:ThemeColorConverter.Instance}}"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0" />

                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                               Text="{Binding DurationText}"
                                               FontSize="9" FontFamily="Consolas"
                                               Foreground="{DynamicResource FgSecondary}"
                                               Margin="0,3,0,0" />

                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                               Text="{Binding PathText}"
                                               FontSize="9"
                                               Foreground="{DynamicResource FgMuted}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,1,0,0" />

                                    <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="3"
                                                Classes="reorder-controls"
                                                Orientation="Vertical"
                                                Spacing="2"
                                                VerticalAlignment="Center"
                                                Margin="6,0,0,0">
                                        <Button Padding="2"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ToolTip.Tip="Subir item"
                                                Command="{Binding $parent[ListBox].DataContext.MoveItemUpCommand}"
                                                CommandParameter="{Binding}">
                                            <materialIcons:MaterialIcon Kind="ChevronUp"
                                                                        Width="14" Height="14"
                                                                        Foreground="{DynamicResource FgPrimary}" />
                                        </Button>
                                        <Button Padding="2"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ToolTip.Tip="Bajar item"
                                                Command="{Binding $parent[ListBox].DataContext.MoveItemDownCommand}"
                                                CommandParameter="{Binding}">
                                            <materialIcons:MaterialIcon Kind="ChevronDown"
                                                                        Width="14" Height="14"
                                                                        Foreground="{DynamicResource FgPrimary}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Controles de reproduccion (centrados) + totalizador de duracion (derecha) -->
        <Border Grid.Row="2"
                Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="0,1,0,0"
                Padding="8,6">
            <Grid ColumnDefinitions="*,Auto,*">

                <Panel Grid.Column="0" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <Button Command="{Binding PrevPlaybackCommand}"
                            IsEnabled="{Binding CanPrevPlayback}"
                            ToolTip.Tip="Elemento anterior"
                            ToolTip.Placement="Bottom"
                            ToolTip.ShowDelay="800"
                            Padding="8,5" Background="Transparent" BorderThickness="0">
                        <materialIcons:MaterialIcon Kind="SkipPrevious"
                                                    Width="16" Height="16"
                                                    Foreground="{DynamicResource FgPrimary}" />
                    </Button>

                    <Button Command="{Binding PlayListCommand}"
                            IsEnabled="{Binding CanPlayList}"
                            ToolTip.Tip="{Binding PlayButtonTooltip}"
                            ToolTip.Placement="Bottom"
                            ToolTip.ShowDelay="800"
                            Padding="8,5" Background="Transparent" BorderThickness="0"
                            IsVisible="{Binding !IsThisListActive}">
                        <materialIcons:MaterialIcon Kind="Play"
                                                    Width="16" Height="16"
                                                    Foreground="{DynamicResource Success}" />
                    </Button>

                    <Button Command="{Binding ResumePlaybackCommand}"
                            IsEnabled="{Binding CanResumePlayback}"
                            ToolTip.Tip="Reanudar"
                            ToolTip.Placement="Bottom"
                            ToolTip.ShowDelay="800"
                            Padding="8,5" Background="Transparent" BorderThickness="0"
                            IsVisible="{Binding IsThisListActive}">
                        <materialIcons:MaterialIcon Kind="Play"
                                                    Width="16" Height="16"
                                                    Foreground="{DynamicResource Success}" />
                    </Button>

                    <Button Command="{Binding PausePlaybackCommand}"
                            IsEnabled="{Binding CanPausePlayback}"
                            ToolTip.Tip="Pausar"
                            ToolTip.Placement="Bottom"
                            ToolTip.ShowDelay="800"
                            Padding="8,5" Background="Transparent" BorderThickness="0">
                        <materialIcons:MaterialIcon Kind="Pause"
                                                    Width="16" Height="16"
                                                    Foreground="{DynamicResource Warning}" />
                    </Button>

                    <Button Command="{Binding StopPlaybackCommand}"
                            IsEnabled="{Binding CanStopThisList}"
                            ToolTip.Tip="Detener"
                            ToolTip.Placement="Bottom"
                            ToolTip.ShowDelay="800"
                            Padding="8,5" Background="Transparent" BorderThickness="0">
                        <materialIcons:MaterialIcon Kind="Stop"
                                                    Width="16" Height="16"
                                                    Foreground="{DynamicResource Error}" />
                    </Button>

                    <Button Command="{Binding NextPlaybackCommand}"
                            IsEnabled="{Binding CanNextPlayback}"
                            ToolTip.Tip="Elemento siguiente"
                            ToolTip.Placement="Bottom"
                            ToolTip.ShowDelay="800"
                            Padding="8,5" Background="Transparent" BorderThickness="0">
                        <materialIcons:MaterialIcon Kind="SkipNext"
                                                    Width="16" Height="16"
                                                    Foreground="{DynamicResource FgPrimary}" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="12,0,4,0"
                            ToolTip.Tip="Duración total de los items habilitados"
                            ToolTip.Placement="Bottom"
                            ToolTip.ShowDelay="800">
                    <materialIcons:MaterialIcon Kind="ClockOutline"
                                                Width="13" Height="13"
                                                Foreground="{DynamicResource FgSecondary}"
                                                VerticalAlignment="Center" />
                    <TextBlock Text="Total:"
                               FontSize="10"
                               Foreground="{DynamicResource FgSecondary}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalDurationText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource FgPrimary}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="3"
                Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="0,1,0,0"
                Padding="6,3">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding DisplayStatusMessage}"
                           FontSize="10"
                           Foreground="{DynamicResource FgSecondary}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{Binding SummaryText}"
                           FontSize="10"
                           Foreground="{DynamicResource FgSecondary}" />
            </Grid>
        </Border>

    </Grid>
</UserControl>