<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RadioMaker.UI.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="RadioMaker.UI.Views.TandaEditorView"
             x:DataType="vm:TandaEditorViewModel">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Barra de herramientas -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgPrimary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="0,0,0,1"
                Padding="4,2">
            <StackPanel Orientation="Horizontal" Spacing="0">
                <Button x:Name="NewButton" Click="OnNewClick"
                        ToolTip.Tip="Nueva tanda" Padding="3" Background="Transparent" BorderThickness="0">
                    <materialIcons:MaterialIcon Kind="FilePlus"
                                                Width="15" Height="15"
                                                Foreground="{DynamicResource FgPrimary}" />
                </Button>

                <Button x:Name="OpenButton" Click="OnOpenClick"
                        ToolTip.Tip="Abrir archivo .tnd" Padding="3" Background="Transparent" BorderThickness="0">
                    <materialIcons:MaterialIcon Kind="FolderOpen"
                                                Width="15" Height="15"
                                                Foreground="{DynamicResource FgPrimary}" />
                </Button>

                <Button x:Name="SaveButton" Click="OnSaveClick"
                        ToolTip.Tip="Guardar en el archivo actual" Padding="3" Background="Transparent" BorderThickness="0">
                    <materialIcons:MaterialIcon Kind="ContentSave"
                                                Width="15" Height="15"
                                                Foreground="{DynamicResource FgPrimary}" />
                </Button>

                <Button x:Name="SaveAsButton" Click="OnSaveAsClick"
                        ToolTip.Tip="Guardar como..." Padding="3" Background="Transparent" BorderThickness="0">
                    <materialIcons:MaterialIcon Kind="ContentSaveEdit"
                                                Width="15" Height="15"
                                                Foreground="{DynamicResource FgPrimary}" />
                </Button>

                <Border Width="1" Background="{DynamicResource BorderPrimary}" Margin="3,2" />

                <Button Command="{Binding AddTrackCommand}"
                        ToolTip.Tip="Agregar pista" Padding="3" Background="Transparent" BorderThickness="0">
                    <materialIcons:MaterialIcon Kind="Plus"
                                                Width="15" Height="15"
                                                Foreground="{DynamicResource AccentText}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Lista de pistas -->
        <ScrollViewer Grid.Row="1" Padding="6">
            <StackPanel Spacing="4">

                <TextBlock Text="Sin pistas. Presiona '+' en la barra superior para agregar una."
                           FontSize="11"
                           Foreground="{DynamicResource FgSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,0"
                           IsVisible="{Binding HasNoTracks}" />

                <ItemsControl ItemsSource="{Binding Tracks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TandaTrackViewModel">
                            <Border BorderBrush="{DynamicResource BorderPrimary}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,6"
                                    Margin="0,0,0,4">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,*,Auto,Auto">

                                    <CheckBox Grid.Row="0" Grid.Column="0"
                                              IsChecked="{Binding IsEnabled}"
                                              Margin="0,0,6,0"
                                              Padding="3,0"
                                              VerticalAlignment="Top"
                                              ToolTip.Tip="Habilitar / deshabilitar esta pista" />

                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FgPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border IsVisible="{Binding IsRmwProject}"
                                                Background="{Binding FileTypeBadgeColor, Converter={x:Static vm:ThemeColorConverter.Instance}}"
                                                CornerRadius="3" Padding="5,1"
                                                VerticalAlignment="Center"
                                                Margin="0,0,0,0">
                                            <TextBlock Text="RMWAVE"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="White" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2"
                                                Orientation="Horizontal" Spacing="0">
                                        <Button x:Name="BrowseTrackButton"
                                                Click="OnBrowseTrackClick"
                                                Padding="3" Background="Transparent" BorderThickness="0"
                                                ToolTip.Tip="Elegir archivo">
                                            <materialIcons:MaterialIcon Kind="FolderOpen"
                                                                        Width="15" Height="15"
                                                                        Foreground="{DynamicResource FgPrimary}" />
                                        </Button>
                                        <Button Click="OnTrackEditInRMWaveClick"
                                                Content="Editar en RMWave..."
                                                IsEnabled="{Binding FilePath, Converter={x:Static vm:IsRmwFileConverter.Instance}}"
                                                ToolTip.Tip="Abrir este proyecto .rmw en la app RMWave"
                                                VerticalAlignment="Center"
                                                Margin="4,0,0,0" />
                                        <Button Command="{Binding $parent[ItemsControl].((vm:TandaEditorViewModel)DataContext).MoveTrackUpCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="3" Background="Transparent" BorderThickness="0"
                                                ToolTip.Tip="Mover arriba">
                                            <materialIcons:MaterialIcon Kind="ArrowUp"
                                                                        Width="15" Height="15"
                                                                        Foreground="{DynamicResource FgPrimary}" />
                                        </Button>
                                        <Button Command="{Binding $parent[ItemsControl].((vm:TandaEditorViewModel)DataContext).MoveTrackDownCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="3" Background="Transparent" BorderThickness="0"
                                                ToolTip.Tip="Mover abajo">
                                            <materialIcons:MaterialIcon Kind="ArrowDown"
                                                                        Width="15" Height="15"
                                                                        Foreground="{DynamicResource FgPrimary}" />
                                        </Button>
                                        <Button Command="{Binding $parent[ItemsControl].((vm:TandaEditorViewModel)DataContext).RemoveTrackCommand}"
                                                CommandParameter="{Binding}"
                                                Padding="3" Background="Transparent" BorderThickness="0"
                                                ToolTip.Tip="Quitar pista">
                                            <materialIcons:MaterialIcon Kind="Close"
                                                                        Width="15" Height="15"
                                                                        Foreground="{DynamicResource Error}" />
                                        </Button>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                               Text="{Binding DurationText}"
                                               FontSize="9"
                                               FontFamily="Consolas"
                                               Foreground="{DynamicResource FgSecondary}"
                                               Margin="0,4,0,0" />

                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                               Text="{Binding FilePath}"
                                               FontSize="9"
                                               Foreground="{DynamicResource FgMuted}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,1,0,0" />

                                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                                Orientation="Horizontal" Spacing="12"
                                                Margin="18,6,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="Volumen:"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       VerticalAlignment="Center" />
                                            <Slider Minimum="-12" Maximum="12"
                                                    Value="{Binding VolumeDb}"
                                                    Width="110"
                                                    TickFrequency="1"
                                                    ToolTip.Tip="{Binding VolumeText}" />
                                            <TextBlock Text="{Binding VolumeText}"
                                                       FontSize="9"
                                                       FontFamily="Consolas"
                                                       Foreground="{DynamicResource FgPrimary}"
                                                       VerticalAlignment="Center"
                                                       MinWidth="50" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="Espera (s):"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       VerticalAlignment="Center" />
                                            <NumericUpDown Value="{Binding DelayBeforeSeconds}"
                                                           Minimum="0" Maximum="600"
                                                           Increment="0.5"
                                                           Width="100"
                                                           FontSize="10"
                                                           ShowButtonSpinner="True"
                                                           ToolTip.Tip="{Binding DelayText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="0,1,0,0"
                Padding="6,3">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="10"
                           Foreground="{DynamicResource FgSecondary}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{Binding SummaryText}"
                           FontSize="10"
                           Foreground="{DynamicResource FgSecondary}" />
            </Grid>
        </Border>

    </Grid>
</UserControl>