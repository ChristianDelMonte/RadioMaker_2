<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RadioMaker.UI.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="RadioMaker.UI.Views.EncadenadoresEditorView"
             x:DataType="vm:EncadenadoresEditorViewModel">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <Border Grid.Row="0" Background="{DynamicResource BgPrimary}"
                BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,0,0,1" Padding="4,2">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Click="OnNewClick" ToolTip.Tip="Nuevo archivo de encadenadores"
                        Padding="3" Background="Transparent" BorderThickness="0">
                    <materialIcons:MaterialIcon Kind="FilePlus" Width="15" Height="15"
                                                Foreground="{DynamicResource FgPrimary}" />
                </Button>
                <Button Click="OnOpenClick" ToolTip.Tip="Abrir archivo .rme"
                        Padding="3" Background="Transparent" BorderThickness="0">
                    <materialIcons:MaterialIcon Kind="FolderOpen" Width="15" Height="15"
                                                Foreground="{DynamicResource FgPrimary}" />
                </Button>
                <Button Click="OnSaveClick" ToolTip.Tip="Guardar"
                        Padding="3" Background="Transparent" BorderThickness="0">
                    <materialIcons:MaterialIcon Kind="ContentSave" Width="15" Height="15"
                                                Foreground="{DynamicResource FgPrimary}" />
                </Button>
                <Button Click="OnSaveAsClick" ToolTip.Tip="Guardar como..."
                        Padding="3" Background="Transparent" BorderThickness="0">
                    <materialIcons:MaterialIcon Kind="ContentSaveEdit" Width="15" Height="15"
                                                Foreground="{DynamicResource FgPrimary}" />
                </Button>
                <Border Width="1" Background="{DynamicResource BorderPrimary}" Margin="3,2" />
                <Button Command="{Binding RemoveSelectedCommand}"
                        IsEnabled="{Binding HasSelection}"
                        ToolTip.Tip="Quitar audio seleccionado"
                        Padding="3" Background="Transparent" BorderThickness="0">
                    <materialIcons:MaterialIcon Kind="Close" Width="15" Height="15"
                                                Foreground="{DynamicResource Error}" />
                </Button>
                <ToggleSwitch IsChecked="{Binding IsActive, Mode=TwoWay}"
                              OnContent="Activado" OffContent="Desactivado"
                              ToolTip.Tip="Solo una pestaña de Encadenadores puede estar activa." />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,0,0,1" Padding="5">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="Audios encadenadores"
                           FontWeight="SemiBold" FontSize="10"
                           Foreground="{DynamicResource FgSecondary}"
                           Margin="8,6,8,3" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Tracks}"
                         SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource BgSelected}" />
                        </Style>
                        <Style Selector="ListBoxItem StackPanel.reorder-controls">
                            <Setter Property="IsVisible" Value="False" />
                        </Style>
                        <Style Selector="ListBoxItem:selected StackPanel.reorder-controls">
                            <Setter Property="IsVisible" Value="True" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="3" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:EncadenadorTrackViewModel">
                            <Border Padding="8,6,8,8"
                                    BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                                            Background="{DynamicResource AccentSoft}"
                                            Width="3" Margin="0,0,8,0" CornerRadius="2" />
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding DisplayTitle}" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FgPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding DurationText}" FontSize="9"
                                               FontFamily="Consolas"
                                               Foreground="{DynamicResource FgSecondary}"
                                               Margin="0,3,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="{Binding FilePath}" FontSize="9"
                                                   Foreground="{DynamicResource FgMuted}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,1,0,0" />
                                    <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
                                                Classes="reorder-controls"
                                                Orientation="Vertical" Spacing="2"
                                                VerticalAlignment="Center" Margin="6,0,0,0">
                                        <Button Padding="2" Background="Transparent" BorderThickness="0"
                                                ToolTip.Tip="Subir audio"
                                                Command="{Binding $parent[ListBox].DataContext.MoveTrackUpCommand}"
                                                CommandParameter="{Binding}">
                                            <materialIcons:MaterialIcon Kind="ChevronUp" Width="14" Height="14"
                                                                        Foreground="{DynamicResource FgPrimary}" />
                                        </Button>
                                        <Button Padding="2" Background="Transparent" BorderThickness="0"
                                                ToolTip.Tip="Bajar audio"
                                                Command="{Binding $parent[ListBox].DataContext.MoveTrackDownCommand}"
                                                CommandParameter="{Binding}">
                                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="14" Height="14"
                                                                        Foreground="{DynamicResource FgPrimary}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource BgPrimary}"
                BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,0,0,1" Padding="8,7">
            <StackPanel Spacing="7">
                <TextBlock Text="Configuración de inserción" FontWeight="SemiBold"
                           FontSize="10" Foreground="{DynamicResource FgSecondary}" />
                <Grid ColumnDefinitions="*,Auto,*,Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Text="Orden"
                               FontSize="10" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding OrderOptions}"
                              SelectedItem="{Binding SelectedOrder, Mode=TwoWay}" MinWidth="145" />
                    <TextBlock Grid.Column="2" Text="Insertar cada"
                               Margin="12,0,5,0" FontSize="10" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="3" ItemsSource="{Binding InsertIntervals}"
                              SelectedItem="{Binding InsertEvery, Mode=TwoWay}" MinWidth="72" />
                    <TextBlock Grid.Column="4" Text="audio(s)"
                               Margin="5,0,12,0" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Text="Reiniciar contador"
                               Margin="0,7,6,0" FontSize="10" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                              ItemsSource="{Binding CounterResetOptions}"
                              SelectedItem="{Binding SelectedCounterReset, Mode=TwoWay}"
                              Margin="0,7,0,0" MinWidth="160" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3"
                               Text="Arrastra archivos desde el File Manager y la lista los intercalará automáticamente."
                               Margin="10,7,0,0" FontSize="10" TextWrapping="Wrap"
                               Foreground="{DynamicResource FgSecondary}" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="0,1,0,0" Padding="6,3">
            <TextBlock Text="{Binding StatusMessage}" FontSize="10"
                       Foreground="{DynamicResource FgSecondary}"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
