<controls:CustomChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RadioMaker.UI.ViewModels"
        xmlns:controls="clr-namespace:RadioMaker.UI.Controls"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="RadioMaker.UI.Views.AutoDjClockWindow"
        x:DataType="vm:AutoDjClockWindowViewModel"
        Title="{DynamicResource Loc.Window.AutoDjPlanner.Title}"
        Width="930" Height="800"
        MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <controls:ModalTitleBar Grid.Row="0"
                                WindowTitle="{DynamicResource Loc.Window.AutoDjPlanner.Title}"
                                IsVisible="{Binding $parent[controls:CustomChromeWindow].IsCustomChromeEnabled}" />

        <Border Grid.Row="1"
                Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="0,0,0,1"
                Padding="8,5">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Click="OnOpenClockClick" Padding="7,4" ToolTip.Tip="{DynamicResource Loc.Views.AutoDj.OpenClockTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <materialIcons:MaterialIcon Kind="FolderOpen" Width="15" Height="15" />
                        <TextBlock Text="{DynamicResource Loc.Views.AutoDj.Open}" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Click="OnSaveClockClick" Padding="7,4" ToolTip.Tip="{DynamicResource Loc.Views.AutoDj.SaveClockTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <materialIcons:MaterialIcon Kind="ContentSave" Width="15" Height="15" />
                        <TextBlock Text="{DynamicResource Loc.Views.AutoDj.SaveClockTooltip}" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Click="OnSaveClockAsClick" Padding="7,4" ToolTip.Tip="{DynamicResource Loc.Views.AutoDj.SaveAsTooltip}">
                    <TextBlock Text="{DynamicResource Loc.Views.AutoDj.SaveAs}" FontSize="11" />
                </Button>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" Margin="16">
            <StackPanel Spacing="14">
                <Border Background="{DynamicResource BgQuaternary}"
                        BorderBrush="{DynamicResource AccentSoft}"
                        BorderThickness="1" CornerRadius="5" Padding="10">
                    <TextBlock TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource FgPrimary}"
                               Text="{DynamicResource Loc.Views.AutoDj.StageDescription}" />
                </Border>

                <StackPanel Spacing="6">
                    <TextBlock Text="{DynamicResource Loc.Views.AutoDj.MusicLibrary}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource FgPrimary}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding SourceFolder}"
                                 PlaceholderText="{DynamicResource Loc.Views.AutoDj.SelectMusicFolder}" FontSize="11" />
                        <Button Grid.Column="1" Click="OnBrowseFolderClick" Padding="9,5">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <materialIcons:MaterialIcon Kind="FolderOpen" Width="15" Height="15" />
                                <TextBlock Text="{DynamicResource Loc.Views.AutoDj.Browse}" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <CheckBox Content="{DynamicResource Loc.Views.AutoDj.IncludeSubfolders}" IsChecked="{Binding IncludeSubfolders}"
                              FontSize="11" Foreground="{DynamicResource FgPrimary}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="{DynamicResource Loc.Views.AutoDj.TargetDuration}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FgPrimary}" />
                        <NumericUpDown Value="{Binding TargetDurationMinutes}" Minimum="5" Maximum="1440"
                                       Increment="5" FormatString="0" Width="150" />
                        <TextBlock Text="{DynamicResource Loc.Views.AutoDj.TargetDurationHelp}"
                                   FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource FgSecondary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="{DynamicResource Loc.Views.AutoDj.ArtistSeparation}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FgPrimary}" />
                        <NumericUpDown Value="{Binding MinTracksBetweenSameArtist}" Minimum="0" Maximum="50"
                                       Increment="1" FormatString="0" Width="150" />
                        <TextBlock Text="{DynamicResource Loc.Views.AutoDj.ArtistSeparationHelp}"
                                   FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource FgSecondary}" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="6">
                    <TextBlock Text="{DynamicResource Loc.Views.AutoDj.ClockSequence}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource FgPrimary}" />
                    <TextBox Text="{Binding ClockSequenceText}"
                             AcceptsReturn="True" Height="120" FontSize="11"
                             TextWrapping="NoWrap"
                             PlaceholderText="{DynamicResource Loc.Views.AutoDj.OneCategoryPerLine}" />
                    <TextBlock Text="{DynamicResource Loc.Views.AutoDj.GenreHelp}"
                               FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource FgSecondary}" />
                </StackPanel>

                <Separator />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc.Views.AutoDj.Preview}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FgPrimary}" />
                        <TextBlock Text="{Binding PreviewSummaryText}" FontSize="11"
                                   Foreground="{DynamicResource AccentText}" IsVisible="{Binding HasPreview}" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding GenerateCommand}" Padding="11,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="AutoFix" Width="15" Height="15" />
                            <TextBlock Text="{DynamicResource Loc.Views.AutoDj.GeneratePreview}" FontSize="11" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Spacing="4" IsVisible="{Binding IsGenerating}">
                    <ProgressBar Minimum="0" Maximum="100"
                                 Value="{Binding GenerationProgress}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                 Height="8" />
                    <TextBlock Text="{Binding GenerationProgressText}" FontSize="10"
                               Foreground="{DynamicResource FgSecondary}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Border BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="1"
                        CornerRadius="5" Padding="5" MinHeight="180">
                    <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PreviewTracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AutoDjClockPreviewItem">
                                    <Grid ColumnDefinitions="38,*,150,130,85" ColumnSpacing="8" Margin="0,3">
                                        <TextBlock Grid.Column="0" Text="{Binding Number}" FontSize="10"
                                                   Foreground="{DynamicResource FgSecondary}" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{Binding Title}" FontSize="11"
                                                       Foreground="{DynamicResource FgPrimary}" />
                                            <TextBlock Text="{Binding Artist}" FontSize="10"
                                                       Foreground="{DynamicResource FgSecondary}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding GenreSlot}" FontSize="10"
                                                   Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="10"
                                                   Foreground="{DynamicResource FgSecondary}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding FilePath}" FontSize="9"
                                                   Foreground="{DynamicResource FgSecondary}" VerticalAlignment="Center"
                                                   ToolTip.Tip="{Binding FilePath}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0,1,0,0" Padding="10,7">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="10"
                           Foreground="{DynamicResource FgSecondary}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1" Click="OnSavePlaylistClick" IsEnabled="{Binding CanSavePlaylist}"
                        Padding="9,5">
                    <TextBlock Text="{DynamicResource Loc.Views.AutoDj.SavePlaylist}" FontSize="11" />
                </Button>
                <Button Grid.Column="2" Click="OnTakeAirClick" Padding="10,5"
                        IsEnabled="{Binding CanTakeAir}">
                    <TextBlock Text="{DynamicResource Loc.Views.AutoDj.TakeAir}" FontSize="11" />
                </Button>
                <Button Grid.Column="3" Click="OnCloseClick" Padding="10,5">
                    <TextBlock Text="{DynamicResource Loc.Views.AutoDj.Close}" FontSize="11" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</controls:CustomChromeWindow>
