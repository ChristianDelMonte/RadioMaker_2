<controls:CustomChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RadioMaker.UI.ViewModels"
        xmlns:controls="clr-namespace:RadioMaker.UI.Controls"
        xmlns:abs="clr-namespace:RadioMaker.Core.Abstractions;assembly=RadioMaker.Core"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="RadioMaker.UI.Views.AudioSettingsWindow"
        x:DataType="vm:AudioSettingsWindowViewModel"
        Title="{DynamicResource Loc.Settings.Window.Title}"
        Width="980" Height="720"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Barra de titulo personalizada -->
        <controls:ModalTitleBar Grid.Row="0"
                                WindowTitle="{Binding $parent[controls:CustomChromeWindow].Title}"
                                IsVisible="{Binding $parent[controls:CustomChromeWindow].IsCustomChromeEnabled}" />

        <!-- Header (subtitulo) -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <TextBlock Grid.Column="0"
                           Text="{DynamicResource Loc.Settings.Header.Description}"
                           FontSize="10"
                           Foreground="{DynamicResource FgSecondary}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc.Settings.Language.Label}"
                               FontSize="10" Foreground="{DynamicResource FgSecondary}"
                               VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                              MinWidth="120" FontSize="10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: barra lateral + contenido -->
        <Grid Grid.Row="2" ColumnDefinitions="210,*">

            <!-- Barra lateral de navegacion -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BgSecondary}"
                    BorderBrush="{DynamicResource BorderPrimary}"
                    BorderThickness="0,0,1,0">
                <ListBox x:Name="NavList"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="6,8">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="10,7" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource BgHover}" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource BgSelected}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:SettingsSectionViewModel">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="{Binding IconKind}"
                                                            Width="15" Height="15"
                                                            Foreground="{DynamicResource FgPrimary}"
                                                            VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}"
                                           FontSize="12"
                                           Foreground="{DynamicResource FgPrimary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Area de contenido -->
            <Border Grid.Column="1"
                    Background="{DynamicResource BgPrimary}">
                <ContentControl Content="{Binding SelectedSection.Content}"
                                Margin="16">
                    <ContentControl.DataTemplates>

                        <!-- Fade -->
                        <DataTemplate DataType="vm:FadePanelViewModel">
                            <ScrollViewer>
                                <controls:FadePanel />
                            </ScrollViewer>
                        </DataTemplate>

                        <!-- Silencios -->
                        <DataTemplate DataType="vm:SilencePanelViewModel">
                            <ScrollViewer>
                                <controls:SilencePanel />
                            </ScrollViewer>
                        </DataTemplate>

                        <!-- Normalizacion -->
                        <DataTemplate DataType="vm:NormalizationPanelViewModel">
                            <ScrollViewer>
                                <controls:NormalizationPanel />
                            </ScrollViewer>
                        </DataTemplate>

                        <!-- Ducking -->
                        <DataTemplate DataType="vm:DuckingPanelViewModel">
                            <ScrollViewer>
                                <controls:DuckingPanel />
                            </ScrollViewer>
                        </DataTemplate>

                        <!-- En Emergencia -->
                        <DataTemplate DataType="vm:EmergencyPanelViewModel">
                            <controls:EmergencyPanel />
                        </DataTemplate>

                        <!-- Comportamiento -->
                        <DataTemplate DataType="vm:BehaviorSettingsViewModel">
                            <ScrollViewer>
                                <StackPanel Spacing="12">

                                    <TextBlock Text="{DynamicResource Loc.Settings.Body.BehaviorTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgPrimary}" />
                                    <TextBlock Text="{DynamicResource Loc.Settings.Body.BehaviorDescription}"
                                               FontSize="10"
                                               Foreground="{DynamicResource FgSecondary}"
                                               TextWrapping="Wrap" />

                                    <!-- Interruption Behavior -->
                                    <Border Background="{DynamicResource BgSecondary}"
                                            BorderBrush="{DynamicResource BorderPrimary}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{DynamicResource Loc.Settings.Body.PlaylistInterruptTitle}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource FgPrimary}" />
                                            <TextBlock Text="{DynamicResource Loc.Settings.Body.PlaylistInterruptDescription}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       TextWrapping="Wrap" />

                                            <ComboBox ItemsSource="{Binding AvailableInterruptionBehaviors}"
                                                      SelectedItem="{Binding InterruptionBehavior}"
                                                      MinWidth="280"
                                                      HorizontalAlignment="Left"
                                                      Margin="0,4,0,0"
                                                      FontSize="11">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={x:Static vm:InterruptionBehaviorLabelConverter.Instance}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <Border Background="{DynamicResource BgQuaternary}"
                                                    BorderBrush="{DynamicResource AccentSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,5"
                                                    Margin="0,4,0,0">
                                                <StackPanel Spacing="3">
                                                    <TextBlock FontSize="10"
                                                               Foreground="{DynamicResource FgSecondary}"
                                                               TextWrapping="Wrap">
                                                        <Run FontWeight="Bold" Foreground="{DynamicResource FgPrimary}" Text="{DynamicResource Loc.Settings.Run.ContinueTitle}" />
                                                        <Run Text="{DynamicResource Loc.Settings.Run.ContinueDescription}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="10"
                                                               Foreground="{DynamicResource FgSecondary}"
                                                               TextWrapping="Wrap">
                                                        <Run FontWeight="Bold" Foreground="{DynamicResource FgPrimary}" Text="{DynamicResource Loc.Settings.Run.SkipTitle}" />
                                                        <Run Text="{DynamicResource Loc.Settings.Run.SkipDescription}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{Binding InterruptionBehaviorSummary}"
                                               FontSize="10"
                                               Foreground="{DynamicResource FgMuted}"
                                               HorizontalAlignment="Right"
                                               Margin="0,4,0,0" />

                                    <!-- ===== EMERGENCIA ===== -->
                                    <Expander Header="{DynamicResource Loc.Settings.Body.EmergencyHeader}"
                                              IsExpanded="False"
                                              HorizontalAlignment="Stretch"
                                              FontSize="12"
                                              Margin="0,12,0,0">
                                        <ContentControl Content="{Binding EmergencyPanel}" Margin="0,8,0,0" />
                                    </Expander>

                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>

                        <!-- Buses de salida -->
                        <DataTemplate DataType="vm:AudioBusesWindowViewModel">
                            <ScrollViewer>
                                <StackPanel Spacing="10">

                                    <TextBlock Text="{DynamicResource Loc.Settings.Body.BusesTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgPrimary}" />
                                    <TextBlock Text="{DynamicResource Loc.Settings.Body.BusesDescription}"
                                               FontSize="10"
                                               Foreground="{DynamicResource FgSecondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,4" />

                                    <!-- Acciones -->
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Command="{Binding AddBusCommand}"
                                                Padding="8,4"
                                                FontSize="11"
                                                Background="{DynamicResource AccentSoft}"
                                                ToolTip.Tip="{DynamicResource Loc.Settings.Body.AddBusTooltip}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path Data="M 8,3 L 8,13 M 3,8 L 13,8"
                                                      Stroke="{DynamicResource AccentText}"
                                                      StrokeThickness="2"
                                                      Fill="Transparent"
                                                      Width="12" Height="12"
                                                      Stretch="Uniform" />
                                                <TextBlock Text="{DynamicResource Loc.Settings.Body.AddBus}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource FgPrimary}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding RefreshDevicesCommand}"
                                                Padding="8,4"
                                                FontSize="11"
                                                ToolTip.Tip="{DynamicResource Loc.Settings.Body.RefreshDevicesTooltip}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path Data="M 10,3 A 7,7 0 1 1 4,7 M 4,3 L 4,7 L 8,7"
                                                      Stroke="{DynamicResource FgPrimary}"
                                                      StrokeThickness="1.5"
                                                      Fill="Transparent"
                                                      Width="12" Height="12"
                                                      Stretch="Uniform" />
                                                <TextBlock Text="{DynamicResource Loc.Settings.Body.RefreshDevices}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource FgPrimary}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Lista de buses -->
                                    <ItemsControl ItemsSource="{Binding Buses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:BusViewModel">
                                                <Border Background="{DynamicResource BgTertiary}"
                                                        BorderBrush="{DynamicResource BorderPrimary}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10,8"
                                                        Margin="0,0,0,6">
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          RowDefinitions="Auto,Auto,Auto">

                                                        <StackPanel Grid.Row="0" Grid.Column="0"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8"
                                                                    Margin="0,0,0,6">
                                                            <TextBlock Text="{DynamicResource Loc.Settings.Body.Name}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource FgSecondary}"
                                                                       VerticalAlignment="Center"
                                                                       MinWidth="70" />
                                                            <TextBox Text="{Binding DisplayName}"
                                                                     FontSize="11"
                                                                     Padding="5,3"
                                                                     Width="200" />
                                                            <Border Background="{DynamicResource AccentSoft}"
                                                                    CornerRadius="3"
                                                                    Padding="5,1"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding IsPrimary}">
                                                                <TextBlock Text="{DynamicResource Loc.Settings.Body.Primary}"
                                                                           FontSize="8"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource AccentText}" />
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="0" Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    Spacing="2">
                                                            <Button Command="{Binding TestToneCommand}"
                                                                    Padding="3"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    ToolTip.Tip="{DynamicResource Loc.Settings.Body.TestTone}">
                                                                <Path Data="M 3,6 L 6,6 L 10,3 L 10,13 L 6,10 L 3,10 Z M 12,5 L 13,6 M 12,10 L 13,9 M 14,4 L 15,5"
                                                                      Stroke="{DynamicResource Success}"
                                                                      StrokeThickness="1.3"
                                                                      Fill="Transparent"
                                                                      Width="13" Height="13"
                                                                      Stretch="Uniform" />
                                                            </Button>
                                                            <Button Command="{Binding RemoveCommand}"
                                                                    IsEnabled="{Binding CanRemove}"
                                                                    Padding="3"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    ToolTip.Tip="{DynamicResource Loc.Settings.Body.RemoveBus}">
                                                                <Path Data="M 4,5 L 12,5 M 5,5 L 5,13 L 11,13 L 11,5 M 7,5 L 7,3 L 9,3 L 9,5"
                                                                      Stroke="{DynamicResource Error}"
                                                                      StrokeThickness="1.3"
                                                                      Fill="Transparent"
                                                                      Width="13" Height="13"
                                                                      Stretch="Uniform" />
                                                            </Button>
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8"
                                                                    Margin="0,0,0,6">
                                                            <TextBlock Text="{DynamicResource Loc.Settings.Body.Device}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource FgSecondary}"
                                                                       VerticalAlignment="Center"
                                                                       MinWidth="70" />
                                                            <ComboBox ItemsSource="{Binding AvailableDevices}"
                                                                      SelectedItem="{Binding SelectedDevice}"
                                                                      IsEnabled="{Binding CanChangeDevice}"
                                                                      FontSize="11"
                                                                      MinWidth="300"
                                                                      MaxWidth="500"
                                                                      HorizontalAlignment="Left">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate DataType="abs:AudioDeviceInfo">
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   FontSize="11" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8">
                                                            <TextBlock Text="{DynamicResource Loc.Settings.Body.Volume}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource FgSecondary}"
                                                                       VerticalAlignment="Center"
                                                                       MinWidth="70" />
                                                            <Slider Minimum="0" Maximum="1"
                                                                    Value="{Binding MasterVolume}"
                                                                    Width="240"
                                                                    VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding MasterVolume, StringFormat='{}{0:P0}'}"
                                                                       FontSize="10"
                                                                       FontFamily="Consolas"
                                                                       Foreground="{DynamicResource FgPrimary}"
                                                                       VerticalAlignment="Center"
                                                                       MinWidth="50" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding StatusMessage}"
                                               FontSize="10"
                                               Foreground="{DynamicResource FgSecondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />

                                    <Border Background="{DynamicResource BgQuaternary}"
                                            BorderBrush="{DynamicResource AccentSoft}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,7"
                                            Margin="0,4,0,0">
                                        <TextBlock Text="{DynamicResource Loc.Settings.Body.PrimaryBusNote}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource FgSecondary}"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>

                        <!-- Ruteo por modulo -->
                        <DataTemplate DataType="vm:RoutingPanelViewModel">
                            <ScrollViewer>
                                <StackPanel Spacing="12">

                                    <TextBlock Text="{DynamicResource Loc.Settings.Body.RoutingTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgPrimary}" />
                                    <TextBlock Text="{DynamicResource Loc.Settings.Body.RoutingDescription}"
                                               FontSize="10"
                                               Foreground="{DynamicResource FgSecondary}"
                                               TextWrapping="Wrap" />

                                    <Border Background="{DynamicResource BgSecondary}"
                                            BorderBrush="{DynamicResource BorderPrimary}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <ToggleSwitch IsChecked="{Binding Main.UseGlobalBus}"
                                                              OnContent=""
                                                              OffContent=""
                                                              VerticalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource Loc.Settings.Body.SingleBus}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource FgPrimary}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock FontSize="10"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"
                                                       Text="{DynamicResource Loc.Settings.Body.SingleBusDescription}" />
                                        </StackPanel>
                                    </Border>

                                   <!-- Bus de AIRE -->
                                    <Border Background="{DynamicResource BgSecondary}"
                                            BorderBrush="{DynamicResource BorderPrimary}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12"
                                            Margin="0,8,0,0">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{DynamicResource Loc.Settings.Body.OnAirBus}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource FgPrimary}" />
                                            <TextBlock FontSize="10"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       TextWrapping="Wrap"
                                                       Text="{DynamicResource Loc.Settings.Body.OnAirBusDescription}" />
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,4,0,0">
                                                <TextBlock Grid.Column="0"
                                                           Text="{DynamicResource Loc.Settings.Body.Bus}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource FgSecondary}"
                                                           VerticalAlignment="Center"
                                                           MinWidth="40" />
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding AvailableBuses}"
                                                          SelectedItem="{Binding SelectedAirBus}"
                                                          MinWidth="220"
                                                          HorizontalAlignment="Left"
                                                          FontSize="11">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="abs:IAudioBus">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="11" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{DynamicResource Loc.Settings.Body.RoutingCurrent}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgPrimary}"
                                               Margin="0,8,0,0" />
                                    <Border Background="{DynamicResource BgTertiary}"
                                            BorderBrush="{DynamicResource BorderPrimary}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <Grid ColumnDefinitions="*,Auto"
                                              RowDefinitions="Auto,Auto,Auto,Auto">

                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="{DynamicResource Loc.Settings.Body.CartBoard}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource FgPrimary}"
                                                       Margin="0,3" />
                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                       Text="{Binding Main.BusSelectorCart.SelectedBus.DisplayName}"
                                                       FontSize="11" FontFamily="Consolas"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       Margin="0,3" />

                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                       Text="{DynamicResource Loc.Settings.Body.Playlists}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource FgPrimary}"
                                                       Margin="0,3" />
                                            <TextBlock Grid.Row="1" Grid.Column="1"
                                                       Text="{Binding Main.BusSelectorPlaylist.SelectedBus.DisplayName}"
                                                       FontSize="11" FontFamily="Consolas"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       Margin="0,3" />

                                            <TextBlock Grid.Row="2" Grid.Column="0"
                                                       Text="{DynamicResource Loc.Settings.Body.Scheduled}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource FgPrimary}"
                                                       Margin="0,3" />
                                            <TextBlock Grid.Row="2" Grid.Column="1"
                                                       Text="{Binding Main.BusSelectorScheduler.SelectedBus.DisplayName}"
                                                       FontSize="11" FontFamily="Consolas"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       Margin="0,3" />

                                            <TextBlock Grid.Row="3" Grid.Column="0"
                                                       Text="{DynamicResource Loc.Settings.Body.FileBrowser}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource FgPrimary}"
                                                       Margin="0,3" />
                                            <TextBlock Grid.Row="3" Grid.Column="1"
                                                       Text="{Binding Main.BusSelectorFileManager.SelectedBus.DisplayName}"
                                                       FontSize="11" FontFamily="Consolas"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       Margin="0,3" />
                                        </Grid>
                                    </Border>

                                    <Border Background="{DynamicResource BgQuaternary}"
                                            BorderBrush="{DynamicResource AccentSoft}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10"
                                            Margin="0,8,0,0">
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource FgSecondary}"
                                                   TextWrapping="Wrap"
                                                   Text="{DynamicResource Loc.Settings.Body.RoutingNote}" />
                                    </Border>

                                    <Expander Header="{DynamicResource Loc.Settings.Body.ExclusivityPolicies}"
                                              IsExpanded="False"
                                              HorizontalAlignment="Stretch"
                                              FontSize="12"
                                              Margin="0,12,0,0">
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <TextBlock FontSize="10"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       TextWrapping="Wrap"
                                                       Text="{DynamicResource Loc.Settings.Body.ExclusivityDescription}" />

                                            <Button Content="{DynamicResource Loc.Settings.Body.ResetPolicies}"
                                                    Command="{Binding ResetPoliciesToDefaultsCommand}"
                                                    HorizontalAlignment="Left"
                                                    Padding="10,5"
                                                    FontSize="11"
                                                    ToolTip.Tip="{DynamicResource Loc.Settings.Body.ResetPoliciesTooltip}" />


                                            <Border Background="{DynamicResource BgTertiary}"
                                                    BorderBrush="{DynamicResource BorderPrimary}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10">
                                                <Grid ColumnDefinitions="*,Auto,110,180"
                                                      RowDefinitions="Auto,*">

                                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                                               Text="{DynamicResource Loc.Settings.Body.Module}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource FgSecondary}"
                                                               Margin="0,0,0,6" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                                               Text="{DynamicResource Loc.Settings.Body.Exclusive}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource FgSecondary}"
                                                               HorizontalAlignment="Center"
                                                               Margin="8,0,8,6" />
                                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                                               Text="{DynamicResource Loc.Settings.Body.Priority}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource FgSecondary}"
                                                               Margin="8,0,8,6" />
                                                    <TextBlock Grid.Row="0" Grid.Column="3"
                                                               Text="{DynamicResource Loc.Settings.Body.OnPreempt}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource FgSecondary}"
                                                               Margin="8,0,0,6"
                                                               ToolTip.Tip="{DynamicResource Loc.Settings.Body.OnPreemptTooltip}" />

                                                    <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                                                  ItemsSource="{Binding ModulePolicies}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ModulePolicyItemViewModel">
                                                                <Grid ColumnDefinitions="*,Auto,110,180"
                                                                      Margin="0,3">
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding RoleLabel}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource FgPrimary}"
                                                                               VerticalAlignment="Center" />
                                                                    <CheckBox Grid.Column="1"
                                                                              IsChecked="{Binding IsExclusive}"
                                                                              HorizontalAlignment="Center"
                                                                              Margin="8,0,8,0"
                                                                              ToolTip.Tip="{DynamicResource Loc.Settings.Body.ExclusiveTooltip}" />
                                                                    <ComboBox Grid.Column="2"
                                                                              ItemsSource="{Binding AvailablePriorities}"
                                                                              SelectedItem="{Binding Priority}"
                                                                              IsEnabled="{Binding IsExclusive}"
                                                                              FontSize="11"
                                                                              HorizontalAlignment="Stretch"
                                                                              Margin="8,0,8,0">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Converter={x:Static vm:ModulePriorityLabelConverter.Instance}}" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                    <ComboBox Grid.Column="3"
                                                                              ItemsSource="{Binding AvailableBehaviors}"
                                                                              SelectedItem="{Binding Behavior}"
                                                                              IsEnabled="{Binding IsExclusive}"
                                                                              FontSize="11"
                                                                              HorizontalAlignment="Stretch"
                                                                              Margin="8,0,0,0"
                                                                              ToolTip.Tip="{DynamicResource Loc.Settings.Body.PreemptActionsTooltip}">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Converter={x:Static vm:ModuleInterruptionBehaviorLabelConverter.Instance}}" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>

                                            <!-- ===== Cuadro explicativo ===== -->
                                            <Border Background="{DynamicResource BgTertiary}"
                                                    BorderBrush="{DynamicResource BorderPrimary}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,10"
                                                    Margin="0,4,0,0">
                                                <StackPanel Spacing="8">

                                                    <TextBlock Text="{DynamicResource Loc.Settings.Body.PolicyHowTitle}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource FgPrimary}" />

                                                    <TextBlock FontSize="10"
                                                               Foreground="{DynamicResource FgSecondary}"
                                                               TextWrapping="Wrap"
                                                               LineHeight="16"
                                                               Text="{DynamicResource Loc.Settings.Body.PolicyHowDescription}" />

                                                    <TextBlock Text="{DynamicResource Loc.Settings.Body.PolicyColumns}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource FgPrimary}"
                                                               Margin="0,4,0,0" />

                                                    <StackPanel Spacing="4">

                                                        <TextBlock FontSize="10"
                                                                   Foreground="{DynamicResource FgSecondary}"
                                                                   TextWrapping="Wrap">
                                                            <Run FontWeight="Bold" Foreground="{DynamicResource FgPrimary}" Text="{DynamicResource Loc.Settings.Run.ExclusiveTitle}" />
                                                            <Run Text="{DynamicResource Loc.Settings.Run.ExclusiveDescription}" />
                                                        </TextBlock>

                                                        <TextBlock FontSize="10"
                                                                   Foreground="{DynamicResource FgSecondary}"
                                                                   TextWrapping="Wrap">
                                                            <Run FontWeight="Bold" Foreground="{DynamicResource FgPrimary}" Text="{DynamicResource Loc.Settings.Run.PriorityTitle}" />
                                                            <Run Text="{DynamicResource Loc.Settings.Run.PriorityDescription}" />
                                                        </TextBlock>

                                                        <TextBlock FontSize="10"
                                                                   Foreground="{DynamicResource FgSecondary}"
                                                                   TextWrapping="Wrap">
                                                            <Run FontWeight="Bold" Foreground="{DynamicResource FgPrimary}" Text="{DynamicResource Loc.Settings.Run.PreemptTitle}" />
                                                            <Run Text="{DynamicResource Loc.Settings.Run.PreemptDescription}" />
                                                        </TextBlock>

                                                    </StackPanel>

                                                    <TextBlock Text="{DynamicResource Loc.Settings.Body.PolicyOperator}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource FgPrimary}"
                                                               Margin="0,6,0,0" />

                                                    <StackPanel Spacing="4">

                                                        <TextBlock FontSize="10"
                                                                   Foreground="{DynamicResource FgSecondary}"
                                                                   TextWrapping="Wrap">
                                                            <Run FontWeight="Bold" Foreground="{DynamicResource FgPrimary}" Text="{DynamicResource Loc.Settings.Run.NormalAirTitle}" />
                                                            <Run Text="{DynamicResource Loc.Settings.Run.NormalAirDescription}" />
                                                        </TextBlock>

                                                        <TextBlock FontSize="10"
                                                                   Foreground="{DynamicResource FgSecondary}"
                                                                   TextWrapping="Wrap">
                                                            <Run FontWeight="Bold" Foreground="{DynamicResource FgPrimary}" Text="{DynamicResource Loc.Settings.Run.AggressiveCartTitle}" />
                                                            <Run Text="{DynamicResource Loc.Settings.Run.AggressiveCartDescription}" />
                                                        </TextBlock>

                                                        <TextBlock FontSize="10"
                                                                   Foreground="{DynamicResource FgSecondary}"
                                                                   TextWrapping="Wrap">
                                                            <Run FontWeight="Bold" Foreground="{DynamicResource FgPrimary}" Text="{DynamicResource Loc.Settings.Run.PreviewTitle}" />
                                                            <Run Text="{DynamicResource Loc.Settings.Run.PreviewDescription}" />
                                                        </TextBlock>

                                                        <TextBlock FontSize="10"
                                                                   Foreground="{DynamicResource FgSecondary}"
                                                                   TextWrapping="Wrap">
                                                            <Run FontWeight="Bold" Foreground="{DynamicResource FgPrimary}" Text="{DynamicResource Loc.Settings.Run.MultiplePlaylistsTitle}" />
                                                            <Run Text="{DynamicResource Loc.Settings.Run.MultiplePlaylistsDescription}" />
                                                        </TextBlock>

                                                    </StackPanel>

                                                    <Border Background="{DynamicResource BgQuaternary}"
                                                            BorderBrush="{DynamicResource AccentSoft}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="8,5"
                                                            Margin="0,4,0,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <materialIcons:MaterialIcon Kind="InformationOutline"
                                                                                        Width="13" Height="13"
                                                                                        Foreground="{DynamicResource AccentText}"
                                                                                        VerticalAlignment="Top"
                                                                                        Margin="0,1,0,0" />
                                                            <TextBlock FontSize="10"
                                                                       Foreground="{DynamicResource FgSecondary}"
                                                                       TextWrapping="Wrap"
                                                                       Text="{DynamicResource Loc.Settings.Body.CrossfadeNote}" />
                                                        </StackPanel>
                                                    </Border>

                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Expander>

                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>

                        <!-- VU Meter -->
                        <DataTemplate DataType="vm:VuMeterSettingsWindowViewModel">
                            <controls:VuMeterPanel />
                        </DataTemplate>

                        <!-- Plugins de formato -->
                        <DataTemplate DataType="vm:PluginsWindowViewModel">
                            <controls:PluginsPanel />
                        </DataTemplate>

                        <!-- Apariencia -->
                        <DataTemplate DataType="vm:AppearancePanelViewModel">
                            <ScrollViewer>
                                <StackPanel Spacing="12">

                                    <TextBlock Text="{DynamicResource Loc.Settings.Body.AppearanceTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgPrimary}" />
                                    <TextBlock Text="{DynamicResource Loc.Settings.Body.AppearanceDescription}"
                                               FontSize="10"
                                               Foreground="{DynamicResource FgSecondary}"
                                               TextWrapping="Wrap" />

                                    <Border Background="{DynamicResource BgSecondary}"
                                            BorderBrush="{DynamicResource BorderPrimary}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel Spacing="10">

                                            <TextBlock Text="{DynamicResource Loc.Settings.Body.Theme}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource FgPrimary}" />

                                            <StackPanel Spacing="6">

                                                <RadioButton GroupName="ThemePref"
                                                             Content="{DynamicResource Loc.Settings.Body.FollowSystem}"
                                                             FontSize="11"
                                                             Foreground="{DynamicResource FgPrimary}"
                                                             IsChecked="{Binding Preference, Converter={x:Static vm:ThemePreferenceMatchConverter.Instance}, ConverterParameter=System}" />

                                                <RadioButton GroupName="ThemePref"
                                                             Content="{DynamicResource Loc.Settings.Body.Light}"
                                                             FontSize="11"
                                                             Foreground="{DynamicResource FgPrimary}"
                                                             IsChecked="{Binding Preference, Converter={x:Static vm:ThemePreferenceMatchConverter.Instance}, ConverterParameter=Light}" />

                                                <RadioButton GroupName="ThemePref"
                                                             Content="{DynamicResource Loc.Settings.Body.Dark}"
                                                             FontSize="11"
                                                             Foreground="{DynamicResource FgPrimary}"
                                                             IsChecked="{Binding Preference, Converter={x:Static vm:ThemePreferenceMatchConverter.Instance}, ConverterParameter=Dark}" />

                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource BgQuaternary}"
                                            BorderBrush="{DynamicResource AccentSoft}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10"
                                            Margin="0,8,0,0">
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource FgSecondary}"
                                                   TextWrapping="Wrap"
                                                   Text="{DynamicResource Loc.Settings.Body.ThemeRestartNote}" />
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>

                        <!-- Datos climaticos (RMVoice) -->
                        <DataTemplate DataType="vm:LocutionPanelViewModel">
                            <ScrollViewer>
                                <StackPanel Spacing="12">

                                    <TextBlock Text="{DynamicResource Loc.Settings.Body.ClimateTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgPrimary}" />
                                    <TextBlock Text="{DynamicResource Loc.Settings.Body.ClimateDescription}"
                                               FontSize="10"
                                               Foreground="{DynamicResource FgSecondary}"
                                               TextWrapping="Wrap" />

                                    <!-- Estado del motor -->
                                    <Border Background="{DynamicResource BgSecondary}"
                                            BorderBrush="{DynamicResource BorderPrimary}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <materialIcons:MaterialIcon Kind="CheckCircle"
                                                                            Width="15" Height="15"
                                                                            Foreground="{DynamicResource Success}"
                                                                            VerticalAlignment="Center"
                                                                            IsVisible="{Binding IsAvailable}" />
                                                <materialIcons:MaterialIcon Kind="AlertCircle"
                                                                            Width="15" Height="15"
                                                                            Foreground="{DynamicResource Error}"
                                                                            VerticalAlignment="Center"
                                                                            IsVisible="{Binding !IsAvailable}" />
                                                <TextBlock Text="{DynamicResource Loc.Settings.Body.RMVoiceEngine}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource FgPrimary}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource Loc.Settings.Body.Available}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Success}"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding IsAvailable}" />
                                                <TextBlock Text="{DynamicResource Loc.Settings.Body.Unavailable}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Error}"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !IsAvailable}" />
                                            </StackPanel>
                                            <TextBlock Text="{DynamicResource Loc.Settings.Body.RMVoiceMissing}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource FgMuted}"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding !IsAvailable}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Bus de salida para locuciones del panel -->
                                    <Border Background="{DynamicResource BgSecondary}"
                                            BorderBrush="{DynamicResource BorderPrimary}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{DynamicResource Loc.Settings.Body.PanelVoiceOutput}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource FgPrimary}" />
                                            <TextBlock Text="{DynamicResource Loc.Settings.Body.PanelVoiceOutputDescription}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       TextWrapping="Wrap" />

                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0"
                                                           Text="{DynamicResource Loc.Settings.Body.Bus}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource FgSecondary}"
                                                           VerticalAlignment="Center"
                                                           MinWidth="80" />
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding AvailableBuses}"
                                                          SelectedItem="{Binding SelectedBus}"
                                                          MinWidth="220"
                                                          HorizontalAlignment="Left"
                                                          FontSize="11">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="abs:IAudioBus">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="11" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{DynamicResource Loc.Settings.Body.VoiceVolume}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource FgSecondary}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Slider Minimum="0" Maximum="1"
                                                            Value="{Binding Settings.ButtonLocutionVolume}"
                                                            Width="240" />
                                                    <TextBlock Text="{Binding Settings.ButtonLocutionVolume, StringFormat='{}{0:P0}'}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource FgPrimary}"
                                                               VerticalAlignment="Center"
                                                               MinWidth="50" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Ducking del audio durante la locucion -->
                                            <Separator Margin="0,4,0,4" />

                                            <CheckBox Content="{DynamicResource Loc.Settings.Body.DuckDuringVoice}"
                                                      FontSize="11"
                                                      Foreground="{DynamicResource FgPrimary}"
                                                      IsChecked="{Binding Settings.ButtonDuckEnabled}" />

                                            <StackPanel Spacing="4"
                                                        IsEnabled="{Binding Settings.ButtonDuckEnabled}">
                                                <TextBlock Text="{DynamicResource Loc.Settings.Body.VoiceDuckLevel}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource FgSecondary}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Slider Minimum="0" Maximum="1"
                                                            Value="{Binding Settings.ButtonDuckLevel}"
                                                            Width="240" />
                                                    <TextBlock Text="{Binding Settings.ButtonDuckLevel, StringFormat='{}{0:P0}'}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource FgPrimary}"
                                                               VerticalAlignment="Center"
                                                               MinWidth="50" />
                                                </StackPanel>
                                                <TextBlock Text="{DynamicResource Loc.Settings.Body.VoiceDuckHelp}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource FgMuted}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>

                                        </StackPanel>
                                    </Border>

                                    <!-- Refresh del clima -->
                                    <Border Background="{DynamicResource BgSecondary}"
                                            BorderBrush="{DynamicResource BorderPrimary}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{DynamicResource Loc.Settings.Body.WeatherRefresh}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource FgPrimary}" />

                                            <CheckBox Content="{DynamicResource Loc.Settings.Body.RefreshAutomatically}"
                                                      FontSize="11"
                                                      Foreground="{DynamicResource FgPrimary}"
                                                      IsChecked="{Binding Settings.AutoRefreshEnabled}" />

                                            <Grid ColumnDefinitions="Auto,Auto,Auto"
                                                  ColumnSpacing="8"
                                                  IsEnabled="{Binding Settings.AutoRefreshEnabled}">
                                                <TextBlock Grid.Column="0"
                                                           Text="{DynamicResource Loc.Settings.Body.Every}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource FgSecondary}"
                                                           VerticalAlignment="Center" />
                                                <NumericUpDown Grid.Column="1"
                                                               Value="{Binding Settings.WeatherRefreshMinutes}"
                                                               Minimum="1" Maximum="180"
                                                               Increment="5"
                                                               Width="100"
                                                               ShowButtonSpinner="True" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{DynamicResource Loc.Settings.Body.Minutes}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource FgSecondary}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <Button Content="{DynamicResource Loc.Settings.Body.RefreshNow}"
                                                    Command="{Binding RefreshWeatherCommand}"
                                                    HorizontalAlignment="Left"
                                                    Padding="10,5"
                                                    Margin="0,4,0,0"
                                                    FontSize="11" />
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>

                    </ContentControl.DataTemplates>
                </ContentControl>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{DynamicResource Loc.Settings.Close}"
                        x:Name="CloseButton"
                        Click="OnCloseClick"
                        MinWidth="90"
                        FontSize="11" />
            </StackPanel>
        </Border>
    </Grid>
</controls:CustomChromeWindow>
