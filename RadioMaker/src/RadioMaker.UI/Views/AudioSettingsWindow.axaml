<controls:CustomChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RadioMaker.UI.ViewModels"
        xmlns:controls="clr-namespace:RadioMaker.UI.Controls"
        xmlns:abs="clr-namespace:RadioMaker.Core.Abstractions;assembly=RadioMaker.Core"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="RadioMaker.UI.Views.AudioSettingsWindow"
        x:DataType="vm:AudioSettingsWindowViewModel"
        Title="Configuracion"
        Width="980" Height="720"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Barra de titulo personalizada -->
        <controls:ModalTitleBar Grid.Row="0"
                                WindowTitle="{Binding $parent[controls:CustomChromeWindow].Title}"
                                IsVisible="{Binding $parent[controls:CustomChromeWindow].IsCustomChromeEnabled}" />

        <!-- Header (subtitulo) -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <StackPanel Spacing="2">
                <TextBlock Text="Ajustes de procesamiento, salidas y comportamiento de la aplicacion."
                           FontSize="10"
                           Foreground="{DynamicResource FgSecondary}" />
            </StackPanel>
        </Border>

        <!-- Body: barra lateral + contenido -->
        <Grid Grid.Row="2" ColumnDefinitions="210,*">

            <!-- Barra lateral de navegacion -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BgSecondary}"
                    BorderBrush="{DynamicResource BorderPrimary}"
                    BorderThickness="0,0,1,0">
                <ListBox x:Name="NavList"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="6,8">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="10,7" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="CornerRadius" Value="6" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource BgHover}" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource BgSelected}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:SettingsSectionViewModel">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="{Binding IconKind}"
                                                            Width="15" Height="15"
                                                            Foreground="{DynamicResource FgPrimary}"
                                                            VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}"
                                           FontSize="12"
                                           Foreground="{DynamicResource FgPrimary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Area de contenido -->
            <Border Grid.Column="1"
                    Background="{DynamicResource BgPrimary}">
                <ContentControl Content="{Binding SelectedSection.Content}"
                                Margin="16">
                    <ContentControl.DataTemplates>

                        <!-- Fade -->
                        <DataTemplate DataType="vm:FadePanelViewModel">
                            <ScrollViewer>
                                <controls:FadePanel />
                            </ScrollViewer>
                        </DataTemplate>

                        <!-- Silencios -->
                        <DataTemplate DataType="vm:SilencePanelViewModel">
                            <ScrollViewer>
                                <controls:SilencePanel />
                            </ScrollViewer>
                        </DataTemplate>

                        <!-- Normalizacion -->
                        <DataTemplate DataType="vm:NormalizationPanelViewModel">
                            <ScrollViewer>
                                <controls:NormalizationPanel />
                            </ScrollViewer>
                        </DataTemplate>

                        <!-- Ducking -->
                        <DataTemplate DataType="vm:DuckingPanelViewModel">
                            <ScrollViewer>
                                <controls:DuckingPanel />
                            </ScrollViewer>
                        </DataTemplate>

                        <!-- En Emergencia -->
                        <DataTemplate DataType="vm:EmergencyPanelViewModel">
                            <controls:EmergencyPanel />
                        </DataTemplate>

                        <!-- Comportamiento -->
                        <DataTemplate DataType="vm:BehaviorSettingsViewModel">
                            <ScrollViewer>
                                <StackPanel Spacing="12">

                                    <TextBlock Text="Comportamiento"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgPrimary}" />
                                    <TextBlock Text="Opciones generales que afectan como responde el sistema a las interrupciones y transiciones entre modulos."
                                               FontSize="10"
                                               Foreground="{DynamicResource FgSecondary}"
                                               TextWrapping="Wrap" />

                                    <!-- Interruption Behavior -->
                                    <Border Background="{DynamicResource BgSecondary}"
                                            BorderBrush="{DynamicResource BorderPrimary}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Cuando un programado interrumpe una playlist"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource FgPrimary}" />
                                            <TextBlock Text="Si un programado (o cualquier modulo con mayor prioridad) interrumpe una playlist que esta sonando, el motor puede reanudarla cuando el programado termine. Esta opcion decide desde que punto reanuda."
                                                       FontSize="10"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       TextWrapping="Wrap" />

                                            <ComboBox ItemsSource="{Binding AvailableInterruptionBehaviors}"
                                                      SelectedItem="{Binding InterruptionBehavior}"
                                                      MinWidth="280"
                                                      HorizontalAlignment="Left"
                                                      Margin="0,4,0,0"
                                                      FontSize="11">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={x:Static vm:InterruptionBehaviorLabelConverter.Instance}}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <Border Background="{DynamicResource BgQuaternary}"
                                                    BorderBrush="{DynamicResource AccentSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,5"
                                                    Margin="0,4,0,0">
                                                <StackPanel Spacing="3">
                                                    <TextBlock FontSize="10"
                                                               Foreground="{DynamicResource FgSecondary}"
                                                               TextWrapping="Wrap">
                                                        <Run FontWeight="Bold" Foreground="{DynamicResource FgPrimary}">Continuar donde quedo:</Run>
                                                        <Run> La playlist se reanuda desde el mismo segundo donde fue pausada.</Run>
                                                    </TextBlock>
                                                    <TextBlock FontSize="10"
                                                               Foreground="{DynamicResource FgSecondary}"
                                                               TextWrapping="Wrap">
                                                        <Run FontWeight="Bold" Foreground="{DynamicResource FgPrimary}">Saltar al siguiente item:</Run>
                                                        <Run> La playlist descarta la pista en curso (la marca como completada) y avanza a la proxima cuando se reanuda.</Run>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{Binding InterruptionBehaviorText, StringFormat='Comportamiento actual: {0}'}"
                                               FontSize="10"
                                               Foreground="{DynamicResource FgMuted}"
                                               HorizontalAlignment="Right"
                                               Margin="0,4,0,0" />

                                    <!-- ===== EMERGENCIA ===== -->
                                    <Expander Header="En Emergencia (Anti-Silencio)"
                                              IsExpanded="False"
                                              HorizontalAlignment="Stretch"
                                              FontSize="12"
                                              Margin="0,12,0,0">
                                        <ContentControl Content="{Binding EmergencyPanel}" Margin="0,8,0,0" />
                                    </Expander>

                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>

                        <!-- Buses de salida -->
                        <DataTemplate DataType="vm:AudioBusesWindowViewModel">
                            <ScrollViewer>
                                <StackPanel Spacing="10">

                                    <TextBlock Text="Buses de salida"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgPrimary}" />
                                    <TextBlock Text="Cada bus es una salida fisica independiente con su propio dispositivo, nombre y volumen master."
                                               FontSize="10"
                                               Foreground="{DynamicResource FgSecondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,4" />

                                    <!-- Acciones -->
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Command="{Binding AddBusCommand}"
                                                Padding="8,4"
                                                FontSize="11"
                                                Background="{DynamicResource AccentSoft}"
                                                ToolTip.Tip="Agregar un nuevo bus de salida">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path Data="M 8,3 L 8,13 M 3,8 L 13,8"
                                                      Stroke="{DynamicResource AccentText}"
                                                      StrokeThickness="2"
                                                      Fill="Transparent"
                                                      Width="12" Height="12"
                                                      Stretch="Uniform" />
                                                <TextBlock Text="Agregar bus"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource FgPrimary}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding RefreshDevicesCommand}"
                                                Padding="8,4"
                                                FontSize="11"
                                                ToolTip.Tip="Actualizar la lista de dispositivos de audio del sistema">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path Data="M 10,3 A 7,7 0 1 1 4,7 M 4,3 L 4,7 L 8,7"
                                                      Stroke="{DynamicResource FgPrimary}"
                                                      StrokeThickness="1.5"
                                                      Fill="Transparent"
                                                      Width="12" Height="12"
                                                      Stretch="Uniform" />
                                                <TextBlock Text="Actualizar dispositivos"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource FgPrimary}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Lista de buses -->
                                    <ItemsControl ItemsSource="{Binding Buses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:BusViewModel">
                                                <Border Background="{DynamicResource BgTertiary}"
                                                        BorderBrush="{DynamicResource BorderPrimary}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10,8"
                                                        Margin="0,0,0,6">
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          RowDefinitions="Auto,Auto,Auto">

                                                        <StackPanel Grid.Row="0" Grid.Column="0"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8"
                                                                    Margin="0,0,0,6">
                                                            <TextBlock Text="Nombre:"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource FgSecondary}"
                                                                       VerticalAlignment="Center"
                                                                       MinWidth="70" />
                                                            <TextBox Text="{Binding DisplayName}"
                                                                     FontSize="11"
                                                                     Padding="5,3"
                                                                     Width="200" />
                                                            <Border Background="{DynamicResource AccentSoft}"
                                                                    CornerRadius="3"
                                                                    Padding="5,1"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding IsPrimary}">
                                                                <TextBlock Text="PRINCIPAL"
                                                                           FontSize="8"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource AccentText}" />
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="0" Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    Spacing="2">
                                                            <Button Command="{Binding TestToneCommand}"
                                                                    Padding="3"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    ToolTip.Tip="Reproducir tono de prueba (440 Hz, 1s)">
                                                                <Path Data="M 3,6 L 6,6 L 10,3 L 10,13 L 6,10 L 3,10 Z M 12,5 L 13,6 M 12,10 L 13,9 M 14,4 L 15,5"
                                                                      Stroke="{DynamicResource Success}"
                                                                      StrokeThickness="1.3"
                                                                      Fill="Transparent"
                                                                      Width="13" Height="13"
                                                                      Stretch="Uniform" />
                                                            </Button>
                                                            <Button Command="{Binding RemoveCommand}"
                                                                    IsEnabled="{Binding CanRemove}"
                                                                    Padding="3"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    ToolTip.Tip="Eliminar bus">
                                                                <Path Data="M 4,5 L 12,5 M 5,5 L 5,13 L 11,13 L 11,5 M 7,5 L 7,3 L 9,3 L 9,5"
                                                                      Stroke="{DynamicResource Error}"
                                                                      StrokeThickness="1.3"
                                                                      Fill="Transparent"
                                                                      Width="13" Height="13"
                                                                      Stretch="Uniform" />
                                                            </Button>
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8"
                                                                    Margin="0,0,0,6">
                                                            <TextBlock Text="Dispositivo:"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource FgSecondary}"
                                                                       VerticalAlignment="Center"
                                                                       MinWidth="70" />
                                                            <ComboBox ItemsSource="{Binding AvailableDevices}"
                                                                      SelectedItem="{Binding SelectedDevice}"
                                                                      IsEnabled="{Binding CanChangeDevice}"
                                                                      FontSize="11"
                                                                      MinWidth="300"
                                                                      MaxWidth="500"
                                                                      HorizontalAlignment="Left">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate DataType="abs:AudioDeviceInfo">
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   FontSize="11" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8">
                                                            <TextBlock Text="Volumen:"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource FgSecondary}"
                                                                       VerticalAlignment="Center"
                                                                       MinWidth="70" />
                                                            <Slider Minimum="0" Maximum="1"
                                                                    Value="{Binding MasterVolume}"
                                                                    Width="240"
                                                                    VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding MasterVolume, StringFormat='{}{0:P0}'}"
                                                                       FontSize="10"
                                                                       FontFamily="Consolas"
                                                                       Foreground="{DynamicResource FgPrimary}"
                                                                       VerticalAlignment="Center"
                                                                       MinWidth="50" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding StatusMessage}"
                                               FontSize="10"
                                               Foreground="{DynamicResource FgSecondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />

                                    <Border Background="{DynamicResource BgQuaternary}"
                                            BorderBrush="{DynamicResource AccentSoft}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,7"
                                            Margin="0,4,0,0">
                                        <TextBlock Text="Nota: el bus principal no puede cambiar de dispositivo desde aca (para no interrumpir reproduccion en curso). Crea un bus nuevo si necesitas una salida alternativa."
                                                   FontSize="10"
                                                   Foreground="{DynamicResource FgSecondary}"
                                                   TextWrapping="Wrap" />
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>

                        <!-- Ruteo por modulo -->
                        <DataTemplate DataType="vm:RoutingPanelViewModel">
                            <ScrollViewer>
                                <StackPanel Spacing="12">

                                    <TextBlock Text="Ruteo por modulo"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgPrimary}" />
                                    <TextBlock Text="Decidi si todos los modulos comparten un unico bus de salida o si cada uno puede salir por un dispositivo distinto."
                                               FontSize="10"
                                               Foreground="{DynamicResource FgSecondary}"
                                               TextWrapping="Wrap" />

                                    <Border Background="{DynamicResource BgSecondary}"
                                            BorderBrush="{DynamicResource BorderPrimary}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <ToggleSwitch IsChecked="{Binding Main.UseGlobalBus}"
                                                              OnContent=""
                                                              OffContent=""
                                                              VerticalAlignment="Center" />
                                                <TextBlock Text="Usar un solo bus para todos los modulos"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource FgPrimary}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock FontSize="10"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"
                                                       Text="Cuando esta activo, todos los modulos comparten el mismo bus. Cuando esta desactivado, cada modulo puede elegir su propio bus de salida desde su panel." />
                                        </StackPanel>
                                    </Border>

                                   <!-- Bus de AIRE -->
                                    <Border Background="{DynamicResource BgSecondary}"
                                            BorderBrush="{DynamicResource BorderPrimary}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12"
                                            Margin="0,8,0,0">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Bus de AIRE"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource FgPrimary}" />
                                            <TextBlock FontSize="10"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       TextWrapping="Wrap"
                                                       Text="El indicador visual AL AIRE y las pestañas que muestran 'en vivo' se encienden cuando hay algo reproduciendose en este bus." />
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,4,0,0">
                                                <TextBlock Grid.Column="0"
                                                           Text="Bus:"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource FgSecondary}"
                                                           VerticalAlignment="Center"
                                                           MinWidth="40" />
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding AvailableBuses}"
                                                          SelectedItem="{Binding SelectedAirBus}"
                                                          MinWidth="220"
                                                          HorizontalAlignment="Left"
                                                          FontSize="11">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="abs:IAudioBus">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="11" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Ruteo actual por modulo"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgPrimary}"
                                               Margin="0,8,0,0" />
                                    <Border Background="{DynamicResource BgTertiary}"
                                            BorderBrush="{DynamicResource BorderPrimary}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <Grid ColumnDefinitions="*,Auto"
                                              RowDefinitions="Auto,Auto,Auto,Auto">

                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="Botonera"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource FgPrimary}"
                                                       Margin="0,3" />
                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                       Text="{Binding Main.BusSelectorCart.SelectedBus.DisplayName}"
                                                       FontSize="11" FontFamily="Consolas"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       Margin="0,3" />

                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                       Text="Playlists"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource FgPrimary}"
                                                       Margin="0,3" />
                                            <TextBlock Grid.Row="1" Grid.Column="1"
                                                       Text="{Binding Main.BusSelectorPlaylist.SelectedBus.DisplayName}"
                                                       FontSize="11" FontFamily="Consolas"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       Margin="0,3" />

                                            <TextBlock Grid.Row="2" Grid.Column="0"
                                                       Text="Programados"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource FgPrimary}"
                                                       Margin="0,3" />
                                            <TextBlock Grid.Row="2" Grid.Column="1"
                                                       Text="{Binding Main.BusSelectorScheduler.SelectedBus.DisplayName}"
                                                       FontSize="11" FontFamily="Consolas"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       Margin="0,3" />

                                            <TextBlock Grid.Row="3" Grid.Column="0"
                                                       Text="Explorador"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource FgPrimary}"
                                                       Margin="0,3" />
                                            <TextBlock Grid.Row="3" Grid.Column="1"
                                                       Text="{Binding Main.BusSelectorFileManager.SelectedBus.DisplayName}"
                                                       FontSize="11" FontFamily="Consolas"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       Margin="0,3" />
                                        </Grid>
                                    </Border>

                                    <Border Background="{DynamicResource BgQuaternary}"
                                            BorderBrush="{DynamicResource AccentSoft}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10"
                                            Margin="0,8,0,0">
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource FgSecondary}"
                                                   TextWrapping="Wrap"
                                                   Text="Nota: los cambios de bus se aplican a los proximos audios. Lo que ya esta sonando termina en el bus anterior sin interrupcion." />
                                    </Border>

                                    <Expander Header="Politicas de exclusividad"
                                              IsExpanded="False"
                                              HorizontalAlignment="Stretch"
                                              FontSize="12"
                                              Margin="0,12,0,0">
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <TextBlock FontSize="10"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       TextWrapping="Wrap"
                                                       Text="Cuando dos modulos quieren sonar en el mismo bus, el coordinador decide quien gana. Regla: mayor prioridad gana; a igual prioridad, el ultimo en disparar gana. Un modulo 'No exclusivo' puede sonar en paralelo sin pelear por el bus." />

                                            <Button Content="Restablecer valores por defecto"
                                                    Command="{Binding ResetPoliciesToDefaultsCommand}"
                                                    HorizontalAlignment="Left"
                                                    Padding="10,5"
                                                    FontSize="11"
                                                    ToolTip.Tip="Restaura todas las politicas a los valores originales: Scheduler con AutoResume, Cart/Playlist con Stop." />


                                            <Border Background="{DynamicResource BgTertiary}"
                                                    BorderBrush="{DynamicResource BorderPrimary}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10">
                                                <Grid ColumnDefinitions="*,Auto,110,180"
                                                      RowDefinitions="Auto,*">

                                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                                               Text="Modulo"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource FgSecondary}"
                                                               Margin="0,0,0,6" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                                               Text="Exclusivo"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource FgSecondary}"
                                                               HorizontalAlignment="Center"
                                                               Margin="8,0,8,6" />
                                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                                               Text="Prioridad"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource FgSecondary}"
                                                               Margin="8,0,8,6" />
                                                    <TextBlock Grid.Row="0" Grid.Column="3"
                                                               Text="Al expropiar"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource FgSecondary}"
                                                               Margin="8,0,0,6"
                                                               ToolTip.Tip="Que le hace este modulo al expropiado cuando lo saca del bus" />

                                                    <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                                                  ItemsSource="{Binding ModulePolicies}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ModulePolicyItemViewModel">
                                                                <Grid ColumnDefinitions="*,Auto,110,180"
                                                                      Margin="0,3">
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding RoleLabel}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource FgPrimary}"
                                                                               VerticalAlignment="Center" />
                                                                    <CheckBox Grid.Column="1"
                                                                              IsChecked="{Binding IsExclusive}"
                                                                              HorizontalAlignment="Center"
                                                                              Margin="8,0,8,0"
                                                                              ToolTip.Tip="Si esta marcado, el modulo pelea por el bus. Si no, suena en paralelo." />
                                                                    <ComboBox Grid.Column="2"
                                                                              ItemsSource="{Binding AvailablePriorities}"
                                                                              SelectedItem="{Binding Priority}"
                                                                              IsEnabled="{Binding IsExclusive}"
                                                                              FontSize="11"
                                                                              HorizontalAlignment="Stretch"
                                                                              Margin="8,0,8,0">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Converter={x:Static vm:ModulePriorityLabelConverter.Instance}}" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                    <ComboBox Grid.Column="3"
                                                                              ItemsSource="{Binding AvailableBehaviors}"
                                                                              SelectedItem="{Binding Behavior}"
                                                                              IsEnabled="{Binding IsExclusive}"
                                                                              FontSize="11"
                                                                              HorizontalAlignment="Stretch"
                                                                              Margin="8,0,0,0"
                                                                              ToolTip.Tip="Detener: fade-out y dispose. Pausar: fade-out y pause (manual). Pausar y reanudar: fade-out, pause y resume al liberar el bus.">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Converter={x:Static vm:ModuleInterruptionBehaviorLabelConverter.Instance}}" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>

                                            <!-- ===== Cuadro explicativo ===== -->
                                            <Border Background="{DynamicResource BgTertiary}"
                                                    BorderBrush="{DynamicResource BorderPrimary}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="12,10"
                                                    Margin="0,4,0,0">
                                                <StackPanel Spacing="8">

                                                    <TextBlock Text="Como funcionan las politicas"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource FgPrimary}" />

                                                    <TextBlock FontSize="10"
                                                               Foreground="{DynamicResource FgSecondary}"
                                                               TextWrapping="Wrap"
                                                               LineHeight="16"
                                                               Text="Cada bus de audio es como un fader de consola: solo un modulo puede tener el control en un momento dado. Cuando dos modulos quieren sonar en el mismo bus, el coordinador decide quien gana segun la configuracion de esta tabla." />

                                                    <TextBlock Text="Que decide cada columna"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource FgPrimary}"
                                                               Margin="0,4,0,0" />

                                                    <StackPanel Spacing="4">

                                                        <TextBlock FontSize="10"
                                                                   Foreground="{DynamicResource FgSecondary}"
                                                                   TextWrapping="Wrap">
                                                            <Run FontWeight="Bold" Foreground="{DynamicResource FgPrimary}">Exclusivo:</Run>
                                                            <Run> Si esta marcado, el modulo pelea por el bus (fade-out del actual, fade-in del nuevo). Si esta desmarcado, suena en paralelo sin afectar al resto. Ejemplo tipico: el Explorador de archivos no es exclusivo para poder preescuchar mientras el aire sigue sonando.</Run>
                                                        </TextBlock>

                                                        <TextBlock FontSize="10"
                                                                   Foreground="{DynamicResource FgSecondary}"
                                                                   TextWrapping="Wrap">
                                                            <Run FontWeight="Bold" Foreground="{DynamicResource FgPrimary}">Prioridad:</Run>
                                                            <Run> Define quien gana cuando dos modulos se pelean por el mismo bus. Mayor prioridad gana. A igual prioridad, el ultimo en dispararse gana (regla FIFO invertido). El valor "AIRE" es el mas alto y esta reservado para el Programado, que representa la salida al aire real.</Run>
                                                        </TextBlock>

                                                        <TextBlock FontSize="10"
                                                                   Foreground="{DynamicResource FgSecondary}"
                                                                   TextWrapping="Wrap">
                                                            <Run FontWeight="Bold" Foreground="{DynamicResource FgPrimary}">Al expropiar:</Run>
                                                            <Run> Define que hace ESTE modulo con el modulo que expulsa cuando toma el bus. Detener = fade-out + descarte. Pausar = fade-out + pausa (el usuario lo reanuda manualmente). Pausar y reanudar = fade-out + pausa; cuando este modulo termine, el expulsado se reanuda automaticamente. Ejemplo tipico: el Programado usa "Pausar y reanudar" para que la musica vuelva sola cuando termina el item programado.</Run>
                                                        </TextBlock>

                                                    </StackPanel>

                                                    <TextBlock Text="Como lo usa el operador"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource FgPrimary}"
                                                               Margin="0,6,0,0" />

                                                    <StackPanel Spacing="4">

                                                        <TextBlock FontSize="10"
                                                                   Foreground="{DynamicResource FgSecondary}"
                                                                   TextWrapping="Wrap">
                                                            <Run FontWeight="Bold" Foreground="{DynamicResource FgPrimary}">• Aire normal:</Run>
                                                            <Run> Programado con prioridad AIRE y "Pausar y reanudar". Cuando entra un programado, lo que estaba sonando (playlist, cart) se pausa y, al terminar, se reanuda solo.</Run>
                                                        </TextBlock>

                                                        <TextBlock FontSize="10"
                                                                   Foreground="{DynamicResource FgSecondary}"
                                                                   TextWrapping="Wrap">
                                                            <Run FontWeight="Bold" Foreground="{DynamicResource FgPrimary}">• Botonera agresiva:</Run>
                                                            <Run> Si queres que un Cart corte definitivamente lo que esta sonando, deja Botonera en "Detener". Si preferis que pause, cambia a "Pausar y reanudar".</Run>
                                                        </TextBlock>

                                                        <TextBlock FontSize="10"
                                                                   Foreground="{DynamicResource FgSecondary}"
                                                                   TextWrapping="Wrap">
                                                            <Run FontWeight="Bold" Foreground="{DynamicResource FgPrimary}">• Preescucha:</Run>
                                                            <Run> Dejá Explorador y Carpetas favoritas en "no exclusivo" para monitorear sin afectar el aire. Si querés que la preescucha corte el aire (raro), marca "exclusivo".</Run>
                                                        </TextBlock>

                                                        <TextBlock FontSize="10"
                                                                   Foreground="{DynamicResource FgSecondary}"
                                                                   TextWrapping="Wrap">
                                                            <Run FontWeight="Bold" Foreground="{DynamicResource FgPrimary}">• Multiples playlists:</Run>
                                                            <Run> Por defecto la ultima playlist que dispara gana y las anteriores se detienen. Si querés conservar varias vivas para alternar, cambia a "no exclusivo" (aunque suenen superpuestas, poco recomendable).</Run>
                                                        </TextBlock>

                                                    </StackPanel>

                                                    <Border Background="{DynamicResource BgQuaternary}"
                                                            BorderBrush="{DynamicResource AccentSoft}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="8,5"
                                                            Margin="0,4,0,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <materialIcons:MaterialIcon Kind="InformationOutline"
                                                                                        Width="13" Height="13"
                                                                                        Foreground="{DynamicResource AccentText}"
                                                                                        VerticalAlignment="Top"
                                                                                        Margin="0,1,0,0" />
                                                            <TextBlock FontSize="10"
                                                                       Foreground="{DynamicResource FgSecondary}"
                                                                       TextWrapping="Wrap"
                                                                       Text="La duracion del crossfade (fade-out + fade-in) se toma del panel de Fade, seccion 'Crossfade entre carts'." />
                                                        </StackPanel>
                                                    </Border>

                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Expander>

                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>

                        <!-- VU Meter -->
                        <DataTemplate DataType="vm:VuMeterSettingsWindowViewModel">
                            <controls:VuMeterPanel />
                        </DataTemplate>

                        <!-- Plugins de formato -->
                        <DataTemplate DataType="vm:PluginsWindowViewModel">
                            <controls:PluginsPanel />
                        </DataTemplate>

                        <!-- Apariencia -->
                        <DataTemplate DataType="vm:AppearancePanelViewModel">
                            <ScrollViewer>
                                <StackPanel Spacing="12">

                                    <TextBlock Text="Apariencia"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgPrimary}" />
                                    <TextBlock Text="Elegi el tema de la aplicacion."
                                               FontSize="10"
                                               Foreground="{DynamicResource FgSecondary}"
                                               TextWrapping="Wrap" />

                                    <Border Background="{DynamicResource BgSecondary}"
                                            BorderBrush="{DynamicResource BorderPrimary}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel Spacing="10">

                                            <TextBlock Text="Tema"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource FgPrimary}" />

                                            <StackPanel Spacing="6">

                                                <RadioButton GroupName="ThemePref"
                                                             Content="Seguir al sistema"
                                                             FontSize="11"
                                                             Foreground="{DynamicResource FgPrimary}"
                                                             IsChecked="{Binding Preference, Converter={x:Static vm:ThemePreferenceMatchConverter.Instance}, ConverterParameter=System}" />

                                                <RadioButton GroupName="ThemePref"
                                                             Content="Claro"
                                                             FontSize="11"
                                                             Foreground="{DynamicResource FgPrimary}"
                                                             IsChecked="{Binding Preference, Converter={x:Static vm:ThemePreferenceMatchConverter.Instance}, ConverterParameter=Light}" />

                                                <RadioButton GroupName="ThemePref"
                                                             Content="Oscuro"
                                                             FontSize="11"
                                                             Foreground="{DynamicResource FgPrimary}"
                                                             IsChecked="{Binding Preference, Converter={x:Static vm:ThemePreferenceMatchConverter.Instance}, ConverterParameter=Dark}" />

                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource BgQuaternary}"
                                            BorderBrush="{DynamicResource AccentSoft}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10"
                                            Margin="0,8,0,0">
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource FgSecondary}"
                                                   TextWrapping="Wrap"
                                                   Text="El tema se guarda automaticamente y se aplica al reiniciar." />
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>

                        <!-- Datos climaticos (RMVoice) -->
                        <DataTemplate DataType="vm:LocutionPanelViewModel">
                            <ScrollViewer>
                                <StackPanel Spacing="12">

                                    <TextBlock Text="Datos climaticos"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource FgPrimary}" />
                                    <TextBlock Text="Configuracion del panel de clima y de las locuciones disparadas desde el TopInfoPanel."
                                               FontSize="10"
                                               Foreground="{DynamicResource FgSecondary}"
                                               TextWrapping="Wrap" />

                                    <!-- Estado del motor -->
                                    <Border Background="{DynamicResource BgSecondary}"
                                            BorderBrush="{DynamicResource BorderPrimary}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <materialIcons:MaterialIcon Kind="CheckCircle"
                                                                            Width="15" Height="15"
                                                                            Foreground="{DynamicResource Success}"
                                                                            VerticalAlignment="Center"
                                                                            IsVisible="{Binding IsAvailable}" />
                                                <materialIcons:MaterialIcon Kind="AlertCircle"
                                                                            Width="15" Height="15"
                                                                            Foreground="{DynamicResource Error}"
                                                                            VerticalAlignment="Center"
                                                                            IsVisible="{Binding !IsAvailable}" />
                                                <TextBlock Text="Motor RMVoice:"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource FgPrimary}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="Disponible"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Success}"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding IsAvailable}" />
                                                <TextBlock Text="No disponible"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Error}"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding !IsAvailable}" />
                                            </StackPanel>
                                            <TextBlock Text="Si RMVoice no esta disponible, verifica que la carpeta Addons/RMVoice y los archivos de regiones esten presentes."
                                                       FontSize="10"
                                                       Foreground="{DynamicResource FgMuted}"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding !IsAvailable}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Bus de salida para locuciones del panel -->
                                    <Border Background="{DynamicResource BgSecondary}"
                                            BorderBrush="{DynamicResource BorderPrimary}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Salida de locuciones desde el panel"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource FgPrimary}" />
                                            <TextBlock Text="Bus de salida para los botones de locucion del TopInfoPanel (hora y clima). No afecta a las locuciones dentro de una playlist."
                                                       FontSize="10"
                                                       Foreground="{DynamicResource FgSecondary}"
                                                       TextWrapping="Wrap" />

                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <TextBlock Grid.Column="0"
                                                           Text="Bus:"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource FgSecondary}"
                                                           VerticalAlignment="Center"
                                                           MinWidth="80" />
                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding AvailableBuses}"
                                                          SelectedItem="{Binding SelectedBus}"
                                                          MinWidth="220"
                                                          HorizontalAlignment="Left"
                                                          FontSize="11">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="abs:IAudioBus">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="11" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Volumen de las locuciones del panel"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource FgSecondary}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Slider Minimum="0" Maximum="1"
                                                            Value="{Binding Settings.ButtonLocutionVolume}"
                                                            Width="240" />
                                                    <TextBlock Text="{Binding Settings.ButtonLocutionVolume, StringFormat='{}{0:P0}'}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource FgPrimary}"
                                                               VerticalAlignment="Center"
                                                               MinWidth="50" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Ducking del audio durante la locucion -->
                                            <Separator Margin="0,4,0,4" />

                                            <CheckBox Content="Reducir el volumen del audio durante la locucion"
                                                      FontSize="11"
                                                      Foreground="{DynamicResource FgPrimary}"
                                                      IsChecked="{Binding Settings.ButtonDuckEnabled}" />

                                            <StackPanel Spacing="4"
                                                        IsEnabled="{Binding Settings.ButtonDuckEnabled}">
                                                <TextBlock Text="Nivel del audio durante la locucion"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource FgSecondary}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Slider Minimum="0" Maximum="1"
                                                            Value="{Binding Settings.ButtonDuckLevel}"
                                                            Width="240" />
                                                    <TextBlock Text="{Binding Settings.ButtonDuckLevel, StringFormat='{}{0:P0}'}"
                                                               FontFamily="Consolas"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource FgPrimary}"
                                                               VerticalAlignment="Center"
                                                               MinWidth="50" />
                                                </StackPanel>
                                                <TextBlock Text="Nivel al que baja el audio del mismo bus mientras suena la locucion. 30% = el audio queda bien de fondo."
                                                           FontSize="10"
                                                           Foreground="{DynamicResource FgMuted}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>

                                        </StackPanel>
                                    </Border>

                                    <!-- Refresh del clima -->
                                    <Border Background="{DynamicResource BgSecondary}"
                                            BorderBrush="{DynamicResource BorderPrimary}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Actualizacion del clima"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource FgPrimary}" />

                                            <CheckBox Content="Refrescar automaticamente"
                                                      FontSize="11"
                                                      Foreground="{DynamicResource FgPrimary}"
                                                      IsChecked="{Binding Settings.AutoRefreshEnabled}" />

                                            <Grid ColumnDefinitions="Auto,Auto,Auto"
                                                  ColumnSpacing="8"
                                                  IsEnabled="{Binding Settings.AutoRefreshEnabled}">
                                                <TextBlock Grid.Column="0"
                                                           Text="Cada"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource FgSecondary}"
                                                           VerticalAlignment="Center" />
                                                <NumericUpDown Grid.Column="1"
                                                               Value="{Binding Settings.WeatherRefreshMinutes}"
                                                               Minimum="1" Maximum="180"
                                                               Increment="5"
                                                               Width="100"
                                                               ShowButtonSpinner="True" />
                                                <TextBlock Grid.Column="2"
                                                           Text="minutos"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource FgSecondary}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <Button Content="Refrescar ahora"
                                                    Command="{Binding RefreshWeatherCommand}"
                                                    HorizontalAlignment="Left"
                                                    Padding="10,5"
                                                    Margin="0,4,0,0"
                                                    FontSize="11" />
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>

                    </ContentControl.DataTemplates>
                </ContentControl>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cerrar"
                        x:Name="CloseButton"
                        Click="OnCloseClick"
                        MinWidth="90"
                        FontSize="11" />
            </StackPanel>
        </Border>
    </Grid>
</controls:CustomChromeWindow>
