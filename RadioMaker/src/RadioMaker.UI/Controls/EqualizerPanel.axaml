<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RadioMaker.UI.ViewModels"
             xmlns:controls="clr-namespace:RadioMaker.UI.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="RadioMaker.UI.Controls.EqualizerPanel"
             x:DataType="vm:EqualizerPanelViewModel">

    <Border BorderBrush="{DynamicResource BorderPrimary}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8">
        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <!-- Fila 0: titulo + enable + preset + reset -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
                  Margin="0,0,0,6">

                <TextBlock Grid.Column="0"
                           Text="{DynamicResource Loc.Controls.Equalizer.Title}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{DynamicResource FgPrimary}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />

                <CheckBox Grid.Column="1"
                          Content="{DynamicResource Loc.Controls.Equalizer.Enable}"
                          IsChecked="{Binding IsEnabled}"
                          FontSize="11"
                          Padding="4,0"
                          Foreground="{DynamicResource FgPrimary}"
                          VerticalAlignment="Center" />

                <!-- Selector de preset (icono + flyout) -->
                <controls:EqPresetSelectorButton Grid.Column="3"
                                                 Margin="8,0,0,0" />

                <!-- Reset a 0 dB -->
                <Button Grid.Column="4"
                        Command="{Binding ResetCommand}"
                        Padding="4,2"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="4,0,0,0"
                        ToolTip.Tip="{DynamicResource Loc.Controls.Equalizer.Reset}">
                    <materialIcons:MaterialIcon Kind="Refresh"
                                                Width="15" Height="15"
                                                Foreground="{DynamicResource FgPrimary}" />
                </Button>

                <!-- Guardar preset (solo si hay nombre nuevo) -->
                <Button Grid.Column="5"
                        Command="{Binding SavePresetCommand}"
                        IsEnabled="{Binding CanSavePreset}"
                        Padding="4,2"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="2,0,0,0"
                        ToolTip.Tip="{DynamicResource Loc.Controls.Equalizer.SavePreset}">
                    <materialIcons:MaterialIcon Kind="ContentSave"
                                                Width="15" Height="15"
                                                Foreground="{DynamicResource AccentText}" />
                </Button>
            </Grid>

            <!-- Fila 1: nombre nuevo preset + eliminar preset -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="Auto,*,Auto"
                  Margin="0,0,0,6">

                <TextBlock Grid.Column="0"
                           Text="{DynamicResource Loc.Controls.Equalizer.NewPreset}"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{DynamicResource FgSecondary}"
                           Margin="0,0,6,0" />

                <TextBox Grid.Column="1"
                         Text="{Binding NewPresetName}"
                         PlaceholderText="{DynamicResource Loc.Controls.Equalizer.PresetName}"
                         FontSize="11"
                         Padding="4,2" />

                <Button Grid.Column="2"
                        Command="{Binding DeletePresetCommand}"
                        IsEnabled="{Binding CanDeletePreset}"
                        Padding="4,2"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="4,0,0,0"
                        ToolTip.Tip="{DynamicResource Loc.Controls.Equalizer.DeletePreset}">
                    <materialIcons:MaterialIcon Kind="Delete"
                                                Width="15" Height="15"
                                                Foreground="{DynamicResource Error}" />
                </Button>
            </Grid>

            <!-- Fila 2: sliders de las 10 bandas -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BgTertiary}"
                    CornerRadius="6"
                    Padding="10,8">
                <ItemsControl ItemsSource="{Binding Bands}"
                              IsEnabled="{Binding IsEnabled}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4"
                                        HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EqBandViewModel">
                            <StackPanel Spacing="2" Width="36">
                                <TextBlock Text="{Binding GainText}"
                                           FontSize="9"
                                           FontFamily="Consolas"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource FgSecondary}" />

                                <Slider Orientation="Vertical"
                                        Height="110"
                                        Minimum="-12"
                                        Maximum="12"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="False"
                                        Value="{Binding Gain}" />

                                <TextBlock Text="{Binding Label}"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource FgPrimary}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Fila 3: status -->
            <TextBlock Grid.Row="3"
                       Text="{Binding StatusMessage}"
                       FontSize="10"
                       Foreground="{DynamicResource FgSecondary}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />

        </Grid>
    </Border>
</UserControl>