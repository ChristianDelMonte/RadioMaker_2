<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RadioMaker.UI.ViewModels"
             xmlns:core="clr-namespace:RadioMaker.Core.Configuration;assembly=RadioMaker.Core"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="RadioMaker.UI.Controls.EmergencyPanel"
             x:DataType="vm:EmergencyPanelViewModel">

    <StackPanel Spacing="12">

        <!-- Toggle global -->
        <Border Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ToggleSwitch IsChecked="{Binding IsEnabled}"
                                  OnContent=""
                                  OffContent=""
                                  VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Loc.Controls.Emergency.Enable}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource FgPrimary}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{DynamicResource Loc.Controls.Emergency.Description}"
                           FontSize="10"
                           Foreground="{DynamicResource FgSecondary}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Deteccion -->
        <Border Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                IsEnabled="{Binding IsEnabled}">
            <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource Loc.Controls.Emergency.Detection}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource FgPrimary}" />

                <StackPanel Spacing="4">
                    <TextBlock FontSize="10" Foreground="{DynamicResource FgSecondary}">
                        <Run Text="{DynamicResource Loc.Controls.Emergency.SilenceThreshold}" />
                        <Run Text="{Binding SilenceThresholdSeconds}" FontWeight="Bold" Foreground="{DynamicResource FgPrimary}" />
                        <Run Text="{DynamicResource Loc.Controls.Emergency.Seconds}" />
                    </TextBlock>
                    <Slider Minimum="5" Maximum="300"
                            Value="{Binding SilenceThresholdSeconds}"
                            TickFrequency="5" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock FontSize="10" Foreground="{DynamicResource FgSecondary}">
                        <Run Text="{DynamicResource Loc.Controls.Emergency.MinimumLevel}" />
                        <Run Text="{Binding ThresholdDb, StringFormat='{}{0:F0} dB'}" FontWeight="Bold" Foreground="{DynamicResource FgPrimary}" />
                    </TextBlock>
                    <Slider Minimum="-100" Maximum="-20"
                            Value="{Binding ThresholdDb}"
                            TickFrequency="5" />
                </StackPanel>

                <Separator Margin="0,4" />

                <CheckBox Content="{DynamicResource Loc.Controls.Emergency.NoChannel}"
                          FontSize="11"
                          Foreground="{DynamicResource FgPrimary}"
                          IsChecked="{Binding DetectNoChannels}" />

                <CheckBox Content="{DynamicResource Loc.Controls.Emergency.BelowThreshold}"
                          FontSize="11"
                          Foreground="{DynamicResource FgPrimary}"
                          IsChecked="{Binding DetectSilence}" />
            </StackPanel>
        </Border>

        <!-- Origen de archivos -->
        <Border Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                IsEnabled="{Binding IsEnabled}">
            <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource Loc.Controls.Emergency.Source}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource FgPrimary}" />

                <ComboBox ItemsSource="{Binding AvailableModes}"
                          SelectedItem="{Binding Mode}"
                          MinWidth="280"
                          HorizontalAlignment="Left"
                          FontSize="11">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static vm:EmergencySourceModeLabelConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Prearmed (visible si Mode lo incluye) -->
                <StackPanel Spacing="4" IsVisible="{Binding IsPrearmed}">
                    <TextBlock Text="{DynamicResource Loc.Controls.Emergency.Playlist}"
                               FontSize="11"
                               Foreground="{DynamicResource FgSecondary}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding PrearmedPlaylistPath}"
                                 IsReadOnly="True"
                                 PlaceholderText="{DynamicResource Loc.Controls.Emergency.NoPlaylist}" />
                        <Button Grid.Column="1"
                                Command="{Binding BrowsePrearmedPlaylistCommand}"
                                Margin="8,0,0,0"
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="FolderOpen" Width="15" Height="15"
                                                            Foreground="{DynamicResource FgPrimary}" />
                                <TextBlock Text="{DynamicResource Loc.Controls.Emergency.Choose}" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Folder (visible si Mode lo incluye) -->
                <StackPanel Spacing="4" IsVisible="{Binding IsFolder}">
                    <TextBlock Text="{DynamicResource Loc.Controls.Emergency.Folder}"
                               FontSize="11"
                               Foreground="{DynamicResource FgSecondary}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding EmergencyFolder}"
                                 IsReadOnly="True"
                                 PlaceholderText="{DynamicResource Loc.Controls.Emergency.NoFolder}" />
                        <Button Grid.Column="1"
                                Command="{Binding BrowseEmergencyFolderCommand}"
                                Margin="8,0,0,0"
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="FolderOpen" Width="15" Height="15"
                                                            Foreground="{DynamicResource FgPrimary}" />
                                <TextBlock Text="{DynamicResource Loc.Controls.Emergency.Choose}" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <CheckBox Content="{DynamicResource Loc.Controls.Emergency.IncludeSubfolders}"
                              FontSize="11"
                              Foreground="{DynamicResource FgPrimary}"
                              IsChecked="{Binding IncludeSubfolders}" />
                </StackPanel>

                <TextBlock Text="{DynamicResource Loc.Controls.Emergency.LoopHelp}"
                           FontSize="10"
                           FontStyle="Italic"
                           Foreground="{DynamicResource FgMuted}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Beep -->
        <Border Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                IsEnabled="{Binding IsEnabled}">
            <StackPanel Spacing="8">
                <TextBlock Text="{DynamicResource Loc.Controls.Emergency.Alarm}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource FgPrimary}" />

                <CheckBox Content="{DynamicResource Loc.Controls.Emergency.BeepEnabled}"
                          FontSize="11"
                          Foreground="{DynamicResource FgPrimary}"
                          IsChecked="{Binding BeepEnabled}" />

                <StackPanel Spacing="4" IsEnabled="{Binding BeepEnabled}">
                    <TextBlock FontSize="10" Foreground="{DynamicResource FgSecondary}">
                        <Run Text="{DynamicResource Loc.Controls.Emergency.BeepEvery}" />
                        <Run Text="{Binding BeepEveryNTracks}" FontWeight="Bold" Foreground="{DynamicResource FgPrimary}" />
                        <Run Text="{DynamicResource Loc.Controls.Emergency.Tracks}" />
                    </TextBlock>
                    <NumericUpDown Value="{Binding BeepEveryNTracks}"
                                   Minimum="1" Maximum="20"
                                   Increment="1"
                                   Width="100"
                                   HorizontalAlignment="Left"
                                   ShowButtonSpinner="True" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Acciones / estado -->
        <Border Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource BorderPrimary}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding TestNowCommand}"
                            Padding="10,5"
                            FontSize="11"
                            ToolTip.Tip="{DynamicResource Loc.Controls.Emergency.TestConfigTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="Alert" Width="14" Height="14"
                                                        Foreground="{DynamicResource Warning}" />
                            <TextBlock Text="{DynamicResource Loc.Controls.Emergency.TestNow}" FontSize="11" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding TestBeepCommand}"
                            Padding="10,5"
                            FontSize="11"
                            ToolTip.Tip="{DynamicResource Loc.Controls.Emergency.TestBeepTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="Bell" Width="14" Height="14"
                                                        Foreground="{DynamicResource AccentText}" />
                            <TextBlock Text="{DynamicResource Loc.Controls.Emergency.TestBeep}" FontSize="11" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding StopEmergencyCommand}"
                            IsVisible="{Binding IsActive}"
                            Background="{DynamicResource Error}"
                            Foreground="White"
                            Padding="10,5"
                            FontSize="11">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="Stop" Width="14" Height="14"
                                                        Foreground="White" />
                            <TextBlock Text="{DynamicResource Loc.Controls.Emergency.Stop}" FontSize="11" FontWeight="Bold" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Background="{DynamicResource BgQuaternary}"
                        BorderBrush="{DynamicResource AccentSoft}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,5"
                        IsVisible="{Binding IsActive}">
                    <TextBlock Text="{Binding LiveStatusText}"
                               FontSize="10"
                               Foreground="{DynamicResource FgSecondary}"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="10"
                           FontStyle="Italic"
                           Foreground="{DynamicResource FgMuted}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>