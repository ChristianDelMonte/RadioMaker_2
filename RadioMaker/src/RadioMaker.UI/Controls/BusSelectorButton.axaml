<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RadioMaker.UI.ViewModels"
             xmlns:core="clr-namespace:RadioMaker.Core.Abstractions;assembly=RadioMaker.Core"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="RadioMaker.UI.Controls.BusSelectorButton"
             x:CompileBindings="False">

    <Button x:Name="SelectorButton"
            Padding="5,2"
            Background="Transparent"
            BorderBrush="{DynamicResource AccentSoft}"
            BorderThickness="1"
            CornerRadius="5"
            VerticalAlignment="Center"
            IsEnabled="{Binding CanChangeBus}"
            ToolTip.Tip="{DynamicResource Loc.BusSelector.Tooltip}">

        <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight"
                    Opened="OnFlyoutOpened">

                <StackPanel Width="260" Spacing="6">

                    <TextBlock Text="{DynamicResource Loc.BusSelector.Title}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{DynamicResource FgPrimary}"
                               Margin="4,2,4,0" />

                    <Border Background="{DynamicResource BgQuaternary}"
                            CornerRadius="4"
                            Padding="8,4"
                            Margin="0,0,0,4">
                        <TextBlock Text="{DynamicResource Loc.BusSelector.Description}"
                                   FontSize="10"
                                   Foreground="{DynamicResource FgSecondary}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <ListBox ItemsSource="{Binding AvailableBuses}"
                             SelectedItem="{Binding SelectedBus, Mode=TwoWay}"
                             MaxHeight="300"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="core:IAudioBus">
                                <StackPanel Spacing="1" Margin="2,3">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="{DynamicResource FgPrimary}" />
                                    <TextBlock Text="{Binding DeviceDisplayName}"
                                               FontSize="10"
                                               Foreground="{DynamicResource FgSecondary}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{DynamicResource Loc.BusSelector.Footer}"
                               FontSize="10"
                               Foreground="{DynamicResource FgSecondary}"
                               TextWrapping="Wrap"
                               Margin="4,4,4,2" />
                </StackPanel>
            </Flyout>
        </Button.Flyout>

        <!-- Contenido visible del boton -->
        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">

            <materialIcons:MaterialIcon Kind="Speaker"
                                        Width="14" Height="14"
                                        Foreground="{DynamicResource FgPrimary}"
                                        VerticalAlignment="Center" />

            <TextBlock Text="{Binding SelectedBus.DisplayName}"
                       FontSize="11"
                       Foreground="{DynamicResource FgPrimary}"
                       VerticalAlignment="Center"
                       MaxWidth="140"
                       TextTrimming="CharacterEllipsis" />

            <materialIcons:MaterialIcon Kind="ChevronDown"
                                        Width="11" Height="11"
                                        Foreground="{DynamicResource FgSecondary}"
                                        VerticalAlignment="Center" />
        </StackPanel>
    </Button>
</UserControl>
