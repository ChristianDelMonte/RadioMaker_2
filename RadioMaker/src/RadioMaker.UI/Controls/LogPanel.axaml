<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RadioMaker.UI.ViewModels"
             xmlns:log="clr-namespace:RadioMaker.Core.Logging;assembly=RadioMaker.Core"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="RadioMaker.UI.Controls.LogPanel"
             x:DataType="vm:PlaybackLogViewModel">

    <Border BorderBrush="{DynamicResource BorderPrimary}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="0">
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- Barra de filtros -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BgPrimary}"
                    BorderBrush="{DynamicResource BorderPrimary}"
                    BorderThickness="0,0,0,1"
                    Padding="6,4">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc.Controls.Log.Title}"
                                   FontWeight="SemiBold"
                                   FontSize="11"
                                   Foreground="{DynamicResource FgPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0" />

                        <CheckBox Content="{DynamicResource Loc.Controls.Log.Debug}"
                                  IsChecked="{Binding ShowDebug}"
                                  FontSize="10"
                                  Padding="3,0"
                                  Foreground="{DynamicResource FgSecondary}" />
                        <TextBlock Text="{Binding DebugCount}"
                                   FontSize="9"
                                   FontFamily="Consolas"
                                   Foreground="{DynamicResource FgMuted}"
                                   VerticalAlignment="Center" />

                        <CheckBox Content="{DynamicResource Loc.Controls.Log.Info}"
                                  IsChecked="{Binding ShowInfo}"
                                  FontSize="10"
                                  Padding="3,0"
                                  Foreground="{DynamicResource FgSecondary}" />
                        <TextBlock Text="{Binding InfoCount}"
                                   FontSize="9"
                                   FontFamily="Consolas"
                                   Foreground="{DynamicResource FgSecondary}"
                                   VerticalAlignment="Center" />

                        <CheckBox Content="{DynamicResource Loc.Controls.Log.Warning}"
                                  IsChecked="{Binding ShowWarning}"
                                  FontSize="10"
                                  Padding="3,0"
                                  Foreground="{DynamicResource Warning}" />
                        <TextBlock Text="{Binding WarningCount}"
                                   FontSize="9"
                                   FontFamily="Consolas"
                                   Foreground="{DynamicResource Warning}"
                                   VerticalAlignment="Center" />

                        <CheckBox Content="{DynamicResource Loc.Controls.Log.Error}"
                                  IsChecked="{Binding ShowError}"
                                  FontSize="10"
                                  Padding="3,0"
                                  Foreground="{DynamicResource Error}" />
                        <TextBlock Text="{Binding ErrorCount}"
                                   FontSize="9"
                                   FontFamily="Consolas"
                                   Foreground="{DynamicResource Error}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <TextBox Text="{Binding FilterText}"
                                 PlaceholderText="{DynamicResource Loc.Controls.Log.Filter}"
                                 FontSize="10"
                                 Padding="4,2"
                                 MinWidth="120"
                                 VerticalAlignment="Center" />

                        <!-- Refrescar -->
                        <Button Command="{Binding ReloadSnapshotCommand}"
                                Padding="3,2" Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{DynamicResource Loc.Controls.Log.Refresh}">
                            <materialIcons:MaterialIcon Kind="Refresh"
                                                        Width="15" Height="15"
                                                        Foreground="{DynamicResource FgPrimary}" />
                        </Button>

                        <!-- Exportar -->
                        <Button x:Name="ExportButton"
                                Click="OnExportClick"
                                Padding="3,2" Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{DynamicResource Loc.Controls.Log.Export}">
                            <materialIcons:MaterialIcon Kind="Upload"
                                                        Width="15" Height="15"
                                                        Foreground="{DynamicResource Success}" />
                        </Button>

                        <!-- Limpiar -->
                        <Button Command="{Binding ClearLogCommand}"
                                Padding="3,2" Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{DynamicResource Loc.Controls.Log.Clear}">
                            <materialIcons:MaterialIcon Kind="Delete"
                                                        Width="15" Height="15"
                                                        Foreground="{DynamicResource Error}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Cabecera de columnas -->
            <Border Grid.Row="1"
                    Background="{DynamicResource BgSecondary}"
                    BorderBrush="{DynamicResource BorderPrimary}"
                    BorderThickness="0,0,0,1"
                    Padding="6,3">
                <Grid ColumnDefinitions="120,50,100,*">
                    <TextBlock Grid.Column="0" Text="{DynamicResource Loc.Controls.Log.DateTime}"
                               FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource FgMuted}" />
                    <TextBlock Grid.Column="1" Text="{DynamicResource Loc.Controls.Log.Level}"
                               FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource FgMuted}" />
                    <TextBlock Grid.Column="2" Text="{DynamicResource Loc.Controls.Log.Category}"
                               FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource FgMuted}" />
                    <TextBlock Grid.Column="3" Text="{DynamicResource Loc.Controls.Log.Message}"
                               FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource FgMuted}" />
                </Grid>
            </Border>

            <!-- Lista de entradas -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BgTertiary}"
                    BorderBrush="{DynamicResource BorderPrimary}"
                    BorderThickness="0">
                <ScrollViewer Name="LogScrollViewer">
                    <ItemsControl ItemsSource="{Binding Entries}" Padding="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="log:LogEntry">
                                <Grid ColumnDefinitions="120,50,100,*" Margin="0,1">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                               FontFamily="Consolas"
                                               FontSize="9"
                                               Foreground="{DynamicResource FgMuted}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding LevelText}"
                                               FontFamily="Consolas"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{Binding LevelColor, Converter={x:Static vm:ThemeColorConverter.Instance}}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Category}"
                                               FontSize="9"
                                               Foreground="{DynamicResource FgSecondary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Message}"
                                               FontSize="10"
                                               Foreground="{DynamicResource FgPrimary}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>