<controls:CustomChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RMVoice.UI.Controls"  
        x:Class="RMVoice.UI.Views.MainWindow"
        Title="RadioMaker Voice addon"
        Width="960" Height="700"
        MinWidth="820" MinHeight="560">

  <controls:CustomChromeWindow.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource RMVCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RMVCardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource RMVCardForeground}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource RMVHintForeground}" />
      <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource RMVCardForeground}" />
    </Style>

    <!-- Tabs compactos -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="TabItem /template/ ContentPresenter">
      <Setter Property="Padding" Value="10,4" />
    </Style>

    <!-- Botones dentro del header (fondo navy): forzar contraste en ambos temas -->
    <Style Selector="Border.hero Button">
      <Setter Property="Background" Value="#1E293B" />
      <Setter Property="Foreground" Value="#E2E8F0" />
      <Setter Property="BorderBrush" Value="#334155" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Border.hero Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#334155" />
    </Style>

    <!-- Chrome custom: hover de minimizar/maximizar -->
    <Style Selector="Button.chrome-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>

    <!-- Chrome custom: hover del boton cerrar (rojo) -->
    <Style Selector="Button.chrome-close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#EF4444" />
    </Style>
  </controls:CustomChromeWindow.Styles>

  <Grid>
    <Grid RowDefinitions="Auto,*">

      <!-- ═══════════════════════════════════════════════════════════ -->
      <!-- BARRA DE TITULO CUSTOM (solo Windows/macOS)                -->
      <!-- ═══════════════════════════════════════════════════════════ -->
      <Border Grid.Row="0"
              Name="CustomTitleBar"
              Background="{DynamicResource RMVCardBackground}"
              BorderBrush="{DynamicResource RMVCardBorder}"
              BorderThickness="0,0,0,1"
              Padding="10,4"
              WindowDecorationProperties.ElementRole="TitleBar"
              IsVisible="{Binding $parent[controls:CustomChromeWindow].IsCustomChromeEnabled}">
        <Grid ColumnDefinitions="*,Auto,*">
          <Panel Grid.Column="0" />

          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <Path Data="M 12 2 A 3 3 0 0 1 15 5 L 15 11 A 3 3 0 0 1 12 14 A 3 3 0 0 1 9 11 L 9 5 A 3 3 0 0 1 12 2 Z M 5 10 A 7 7 0 0 0 12 17 A 7 7 0 0 0 19 10 M 12 17 L 12 21 M 8 21 L 16 21"
                  Stroke="#4D6BFE"
                  StrokeThickness="1.5"
                  Fill="Transparent"
                  Stretch="Uniform"
                  Width="18" Height="18"
                  VerticalAlignment="Center" />
            <TextBlock Text="RadioMaker Voice addon"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="{DynamicResource RMVCardForeground}"
                       VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center">
            <Button Name="MinimizeButton"
                    Classes="chrome-btn"
                    WindowDecorationProperties.ElementRole="MinimizeButton"
                    Padding="10,4"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip.Tip="Minimizar">
                  <Rectangle Width="10" Height="1.5"
                             Fill="{DynamicResource RMVCardForeground}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
            </Button>
            <Button Name="MaximizeButton"
                    Classes="chrome-btn"
                    WindowDecorationProperties.ElementRole="MaximizeButton"
                    Padding="10,4"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip.Tip="Maximizar">
              <Path Name="MaximizeIconPath"
                    Data="M 2 2 L 12 2 L 12 12 L 2 12 Z"
                    Stroke="{DynamicResource RMVCardForeground}"
                    StrokeThickness="1.3"
                    Fill="Transparent"
                    Stretch="Uniform"
                    Width="12" Height="12" />
            </Button>
            <Button Name="CloseButton"
                    Classes="chrome-close"
                    WindowDecorationProperties.ElementRole="CloseButton"
                    Padding="10,4"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip.Tip="Cerrar">
              <Path Data="M 3 3 L 11 11 M 11 3 L 3 11"
                    Stroke="{DynamicResource RMVCardForeground}"
                    StrokeThickness="1.5"
                    Fill="Transparent"
                    Stretch="Uniform"
                    Width="12" Height="12" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ═══════════════════════════════════════════════════════════ -->
      <!-- CONTENIDO ORIGINAL (solo se agrego Grid.Row="1")           -->
      <!-- ═══════════════════════════════════════════════════════════ -->
      <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" Margin="12">

    <!--  CABECERA / RELOJ  -->
    <Border Grid.Row="0"
            Classes="hero"
            CornerRadius="12"
            Padding="16"
            Background="#0F172A"
            Margin="0,0,0,10">
      <Grid ColumnDefinitions="*,320">
        <StackPanel>
          <TextBlock Text="{Binding CurrentTimeText}"
                     FontSize="44"
                     FontWeight="Bold"
                     Foreground="#FFFFFF" />
          <TextBlock Text="{Binding CurrentDateText}"
                     FontSize="12"
                     Foreground="#94A3B8" />
          <TextBlock Text="{Binding ClimateSummary}"
                     FontSize="13"
                     Foreground="#60A5FA"
                     Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">

          <!-- Fila superior: etiqueta + boton de tema -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="Perfil de voz"
                       Foreground="#94A3B8"
                       FontSize="11"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Command="{Binding ToggleThemeCommand}"
                    Padding="6,3"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTip.Tip="Cambiar entre tema claro y oscuro">
              <Panel Width="16" Height="16">
                <!-- Sol: se muestra cuando el tema actual es oscuro -->
                <Path Data="M 8 1 L 8 3 M 8 13 L 8 15 M 1 8 L 3 8 M 13 8 L 15 8 M 3 3 L 4.4 4.4 M 11.6 11.6 L 13 13 M 3 13 L 4.4 11.6 M 11.6 4.4 L 13 3 M 5 8 A 3 3 0 1 1 11 8 A 3 3 0 1 1 5 8 Z"
                      Stroke="#FBBF24"
                      StrokeThickness="1.3"
                      Fill="Transparent"
                      Stretch="Uniform"
                      IsVisible="{Binding IsDarkTheme}" />

                <!-- Luna: se muestra cuando el tema actual es claro -->
                <Path Data="M 13 8 A 5.5 5.5 0 1 1 5 2 A 4.5 4.5 0 0 0 13 8 Z"
                      Stroke="#CBD5E1"
                      StrokeThickness="1.3"
                      Fill="Transparent"
                      Stretch="Uniform"
                      IsVisible="{Binding !IsDarkTheme}" />
              </Panel>
            </Button>
          </Grid>

          <ComboBox ItemsSource="{Binding Profiles}"
                    SelectedItem="{Binding SelectedProfile}"
                    HorizontalAlignment="Stretch"
                    FontSize="11">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Text="{Binding Language}" Foreground="#9CA3AF" />
                  <TextBlock Text="{Binding Gender}" Foreground="#9CA3AF" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Añadir" Command="{Binding AddProfileCommand}" />
            <Button Content="Duplicar" Command="{Binding DuplicateProfileCommand}" />
            <Button Content="Eliminar" Command="{Binding RemoveProfileCommand}" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!--  CONTENIDO  -->
    <TabControl Grid.Row="1">

      <!--  Pestaña: Reproducción  -->
      <TabItem Header="Reproducción">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="0,8,0,0">

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="Archivos del perfil" />

                <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="Audio HORAS" />
                  <TextBox   Grid.Row="0" Grid.Column="1" Margin="6,2"
                             Text="{Binding SelectedProfile.HourAudioPath}" />
                  <Button    Grid.Row="0" Grid.Column="2" Margin="3" Width="34" Content="…"
                             Command="{Binding BrowseHourAudioCommand}" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldLabel" Text="Tabla HORAS" />
                  <TextBox   Grid.Row="1" Grid.Column="1" Margin="6,2"
                             Text="{Binding SelectedProfile.HourTablePath}" />
                  <Button    Grid.Row="1" Grid.Column="2" Margin="3" Width="34" Content="…"
                             Command="{Binding BrowseHourTableCommand}" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldLabel" Text="Audio MINUTOS" />
                  <TextBox   Grid.Row="2" Grid.Column="1" Margin="6,2"
                             Text="{Binding SelectedProfile.MinuteAudioPath}" />
                  <Button    Grid.Row="2" Grid.Column="2" Margin="3" Width="34" Content="…"
                             Command="{Binding BrowseMinuteAudioCommand}" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Classes="fieldLabel" Text="Tabla MINUTOS" />
                  <TextBox   Grid.Row="3" Grid.Column="1" Margin="6,2"
                             Text="{Binding SelectedProfile.MinuteTablePath}" />
                  <Button    Grid.Row="3" Grid.Column="2" Margin="3" Width="34" Content="…"
                             Command="{Binding BrowseMinuteTableCommand}" />

                  <TextBlock Grid.Row="4" Grid.Column="0" Classes="fieldLabel" Text="Audio TEMPERATURA" />
                  <TextBox   Grid.Row="4" Grid.Column="1" Margin="6,2"
                             Text="{Binding SelectedProfile.TemperatureAudioPath}" />
                  <Button    Grid.Row="4" Grid.Column="2" Margin="3" Width="34" Content="…"
                             Command="{Binding BrowseTemperatureAudioCommand}" />

                  <TextBlock Grid.Row="5" Grid.Column="0" Classes="fieldLabel" Text="Tabla TEMPERATURA" />
                  <TextBox   Grid.Row="5" Grid.Column="1" Margin="6,2"
                             Text="{Binding SelectedProfile.TemperatureTablePath}" />
                  <Button    Grid.Row="5" Grid.Column="2" Margin="3" Width="34" Content="…"
                             Command="{Binding BrowseTemperatureTableCommand}" />

                  <TextBlock Grid.Row="6" Grid.Column="0" Classes="fieldLabel" Text="Audio HUMEDAD" />
                  <TextBox   Grid.Row="6" Grid.Column="1" Margin="6,2"
                             Text="{Binding SelectedProfile.HumidityAudioPath}" />
                  <Button    Grid.Row="6" Grid.Column="2" Margin="3" Width="34" Content="…"
                             Command="{Binding BrowseHumidityAudioCommand}" />

                  <TextBlock Grid.Row="7" Grid.Column="0" Classes="fieldLabel" Text="Tabla HUMEDAD" />
                  <TextBox   Grid.Row="7" Grid.Column="1" Margin="6,2"
                             Text="{Binding SelectedProfile.HumidityTablePath}" />
                  <Button    Grid.Row="7" Grid.Column="2" Margin="3" Width="34" Content="…"
                             Command="{Binding BrowseHumidityTableCommand}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Recargar perfil" Command="{Binding ReloadProfileCommand}" />
                  <Button Content="Guardar perfiles" Command="{Binding SaveProfilesCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="Prueba manual" />

                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto">
                  <TextBlock Grid.Column="0" Classes="fieldLabel" Text="Hora" Margin="0,0,6,0" />
                  <ComboBox  Grid.Column="1" ItemsSource="{Binding Hours}"
                             SelectedItem="{Binding SelectedHour}"
                             Width="70" Margin="0,0,12,0" FontSize="11" />

                  <TextBlock Grid.Column="2" Classes="fieldLabel" Text="Minuto" Margin="0,0,6,0" />
                  <ComboBox  Grid.Column="3" ItemsSource="{Binding Minutes}"
                             SelectedItem="{Binding SelectedMinute}"
                             Width="70" Margin="0,0,12,0" FontSize="11" />

                  <TextBlock Grid.Column="4" Classes="fieldLabel" Text="Temperatura (°C)" Margin="0,0,6,0" />
                  <NumericUpDown Grid.Column="5"
                                 Value="{Binding Temperature}"
                                 Minimum="-30" Maximum="50"
                                 Increment="1"
                                 FormatString="0.#"
                                 Width="120" FontSize="11" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="fieldLabel" Text="Humedad (%)" />
                    <NumericUpDown Value="{Binding Humidity}"
                                   Minimum="0" Maximum="100"
                                   Increment="1"
                                   FormatString="0"
                                   Width="100" FontSize="11" />
                  </StackPanel>

                  <TextBlock Classes="fieldLabel" Text="Modo:" />
                  <ComboBox ItemsSource="{Binding AnnounceModes}"
                            SelectedItem="{Binding ManualMode}"
                            Width="220" FontSize="11" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="▶  Reproducir selección" Command="{Binding PlayManualCommand}" />
                  <Button Content="■  Detener" Command="{Binding StopCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="Anuncio rápido" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="🔊  Hora actual" Command="{Binding PlayCurrentTimeCommand}" />
                  <Button Content="🌡  Solo clima" Command="{Binding PlayCurrentClimateCommand}" />
                  <Button Content="🔊🌡  Hora + clima" Command="{Binding PlayCurrentTimeAndClimateCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <CheckBox Content="Anunciar automáticamente cada minuto"
                            IsChecked="{Binding AutoAnnounce}"
                            VerticalAlignment="Center"
                            FontSize="11" />
                  <TextBlock Classes="fieldLabel" Text="Modo automático:" />
                  <ComboBox ItemsSource="{Binding AnnounceModes}"
                            SelectedItem="{Binding AutoAnnounceMode}"
                            Width="220" FontSize="11" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Classes="fieldLabel" Text="Volumen" />
                  <Slider Minimum="0" Maximum="100" Width="280"
                          Value="{Binding Volume}" />
                  <TextBlock Text="{Binding VolumeText}" VerticalAlignment="Center" Width="52" FontSize="11" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Estado" />
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource RMVCardForeground}" />
                <TextBlock Classes="hint"
                           TextWrapping="Wrap"
                           Text="Modos disponibles: HourMinute (solo hora y minutos), ClimateOnly (solo temperatura y humedad) y HourMinuteAndClimate (todo). El clima se puede obtener automáticamente desde Open-Meteo en la pestaña «Clima (Open-Meteo)»." />
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!--  Pestaña: Clima (Open-Meteo)  -->
      <TabItem Header="Clima">
        <ScrollViewer>
          <StackPanel Spacing="10" Margin="0,8,0,0">

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="Buscar ubicación" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox Text="{Binding Weather.SearchQuery, Mode=TwoWay}"
                           PlaceholderText="Ciudad, región o país…"
                           Width="320" FontSize="11" />
                  <Button Content="Buscar"
                          Command="{Binding Weather.SearchCommand}"
                          IsEnabled="{Binding !Weather.IsSearching}" />
                  <TextBlock Text="Buscando…"
                             IsVisible="{Binding Weather.IsSearching}"
                             VerticalAlignment="Center"
                             FontSize="11"
                             Foreground="{DynamicResource RMVHintForeground}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Weather.Results}"
                         SelectedItem="{Binding Weather.Candidate, Mode=TwoWay}"
                         MaxHeight="200"
                         FontSize="11">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding DisplayName}" />
                        <TextBlock Text="{Binding CoordinatesText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource RMVHintForeground}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Usar esta ubicación"
                          Command="{Binding Weather.ApplyLocationCommand}" />
                  <TextBlock Classes="hint"
                             VerticalAlignment="Center"
                             TextWrapping="Wrap"
                             Text="{Binding Weather.StatusMessage}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="Ubicación activa" />

                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Weather.ActiveLocationDisplay}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource RMVCardForeground}" />
                  <TextBlock Text="{Binding Weather.ActiveLocationCoordinates}"
                             Classes="hint" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="🌦  Obtener ahora"
                          Command="{Binding Weather.FetchNowCommand}"
                          IsEnabled="{Binding !Weather.IsFetching}" />
                  <Button Content="Limpiar"
                          Command="{Binding Weather.ClearLocationCommand}" />
                  <TextBlock Text="Obteniendo datos…"
                             IsVisible="{Binding Weather.IsFetching}"
                             VerticalAlignment="Center"
                             FontSize="11"
                             Foreground="{DynamicResource RMVHintForeground}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="section" Text="Actualización automática" />

                <CheckBox Content="Actualizar automáticamente el clima"
                          IsChecked="{Binding Weather.AutoRefresh}"
                          FontSize="11" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="fieldLabel" Text="Cada" />
                  <NumericUpDown Value="{Binding Weather.RefreshMinutes}"
                                 Minimum="1" Maximum="180"
                                 Increment="1"
                                 FormatString="0"
                                 Width="100" FontSize="11" />
                  <TextBlock Classes="fieldLabel" Text="minutos" />
                </StackPanel>

                <CheckBox Content="Anunciar por voz después de cada actualización"
                          IsChecked="{Binding Weather.AnnounceAfterFetch}"
                          FontSize="11" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Estado del clima" />
                <TextBlock Text="{Binding Weather.LastUpdateText}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource RMVCardForeground}" />
                <TextBlock Classes="hint"
                           TextWrapping="Wrap"
                           Text="Open-Meteo no requiere API key. Si actualizas automáticamente y marcas «Anunciar por voz…», la app reproducirá el anuncio en cada refresco con los valores obtenidos." />
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!--  Pestaña: Tabla HORAS  -->
      <TabItem Header="Tabla HORAS">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <Button Content="Guardar" Command="{Binding SaveHourTableCommand}" />
            <Button Content="Guardar como…" Command="{Binding SaveHourTableAsCommand}" />
            <Button Content="Recargar desde archivo" Command="{Binding ReloadHourTableCommand}" />
            <TextBlock Classes="hint" VerticalAlignment="Center"
                       Text="{Binding SelectedProfile.HourTablePath}" />
          </StackPanel>
          <DataGrid ItemsSource="{Binding HourRegions}"
                    AutoGenerateColumns="False"
                    CanUserReorderColumns="False"
                    CanUserSortColumns="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Índice" Binding="{Binding Index}" Width="80" />
              <DataGridTextColumn Header="Inicio (HH:MM:SS.f)" Binding="{Binding StartText}" Width="*" />
              <DataGridTextColumn Header="Fin (HH:MM:SS.f)" Binding="{Binding EndText}" Width="*" />
              <DataGridTextColumn Header="Duración (s)" Binding="{Binding DurationText}" Width="120" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!--  Pestaña: Tabla MINUTOS  -->
      <TabItem Header="Tabla MINUTOS">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <Button Content="Guardar" Command="{Binding SaveMinuteTableCommand}" />
            <Button Content="Guardar como…" Command="{Binding SaveMinuteTableAsCommand}" />
            <Button Content="Recargar desde archivo" Command="{Binding ReloadMinuteTableCommand}" />
            <TextBlock Classes="hint" VerticalAlignment="Center"
                       Text="{Binding SelectedProfile.MinuteTablePath}" />
          </StackPanel>
          <DataGrid ItemsSource="{Binding MinuteRegions}"
                    AutoGenerateColumns="False"
                    CanUserReorderColumns="False"
                    CanUserSortColumns="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Índice" Binding="{Binding Index}" Width="80" />
              <DataGridTextColumn Header="Inicio (HH:MM:SS.f)" Binding="{Binding StartText}" Width="*" />
              <DataGridTextColumn Header="Fin (HH:MM:SS.f)" Binding="{Binding EndText}" Width="*" />
              <DataGridTextColumn Header="Duración (s)" Binding="{Binding DurationText}" Width="120" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!--  Pestaña: Tabla TEMPERATURA  -->
      <TabItem Header="Tabla TEMPERATURA">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <Button Content="Guardar" Command="{Binding SaveTemperatureTableCommand}" />
            <Button Content="Guardar como…" Command="{Binding SaveTemperatureTableAsCommand}" />
            <Button Content="Recargar desde archivo" Command="{Binding ReloadTemperatureTableCommand}" />
            <TextBlock Classes="hint" VerticalAlignment="Center"
                       Text="{Binding SelectedProfile.TemperatureTablePath}" />
          </StackPanel>
          <DataGrid ItemsSource="{Binding TemperatureRegions}"
                    AutoGenerateColumns="False"
                    CanUserReorderColumns="False"
                    CanUserSortColumns="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Índice" Binding="{Binding Index}" Width="80" />
              <DataGridTextColumn Header="Inicio (HH:MM:SS.f)" Binding="{Binding StartText}" Width="*" />
              <DataGridTextColumn Header="Fin (HH:MM:SS.f)" Binding="{Binding EndText}" Width="*" />
              <DataGridTextColumn Header="Duración (s)" Binding="{Binding DurationText}" Width="120" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!--  Pestaña: Tabla HUMEDAD  -->
      <TabItem Header="Tabla HUMEDAD">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <Button Content="Guardar" Command="{Binding SaveHumidityTableCommand}" />
            <Button Content="Guardar como…" Command="{Binding SaveHumidityTableAsCommand}" />
            <Button Content="Recargar desde archivo" Command="{Binding ReloadHumidityTableCommand}" />
            <TextBlock Classes="hint" VerticalAlignment="Center"
                       Text="{Binding SelectedProfile.HumidityTablePath}" />
          </StackPanel>
          <DataGrid ItemsSource="{Binding HumidityRegions}"
                    AutoGenerateColumns="False"
                    CanUserReorderColumns="False"
                    CanUserSortColumns="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Índice" Binding="{Binding Index}" Width="80" />
              <DataGridTextColumn Header="Inicio (HH:MM:SS.f)" Binding="{Binding StartText}" Width="*" />
              <DataGridTextColumn Header="Fin (HH:MM:SS.f)" Binding="{Binding EndText}" Width="*" />
              <DataGridTextColumn Header="Duración (s)" Binding="{Binding DurationText}" Width="120" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

    </TabControl>

    <!--  BARRA DE ESTADO  -->
    <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,5" CornerRadius="8"
            Background="{DynamicResource RMVStatusBarBackground}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="●" Foreground="#22C55E" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource RMVStatusBarForeground}"
                   TextTrimming="CharacterEllipsis"
                   Text="{Binding StatusMessage}" />
        <TextBlock Grid.Column="2"
                   VerticalAlignment="Center"
                   Classes="hint"
                   Text="{Binding IsPlaying, StringFormat='Reproduciendo: {0}'}" />
      </Grid>
    </Border>

      </Grid>
    </Grid>

    <!-- Zonas de resize para chrome custom (solo Win/Mac) -->
    <Grid IsVisible="{Binding $parent[controls:CustomChromeWindow].IsCustomChromeEnabled}">
      <Grid.RowDefinitions>
        <RowDefinition Height="5" />
        <RowDefinition Height="*" />
        <RowDefinition Height="5" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="5" />
      </Grid.ColumnDefinitions>

      <Border Grid.Row="0" Grid.Column="0" Background="Transparent" WindowDecorationProperties.ElementRole="ResizeNW" />
      <Border Grid.Row="0" Grid.Column="1" Background="Transparent" WindowDecorationProperties.ElementRole="ResizeN" />
      <Border Grid.Row="0" Grid.Column="2" Background="Transparent" WindowDecorationProperties.ElementRole="ResizeNE" />
      <Border Grid.Row="1" Grid.Column="0" Background="Transparent" WindowDecorationProperties.ElementRole="ResizeW" />
      <Border Grid.Row="1" Grid.Column="2" Background="Transparent" WindowDecorationProperties.ElementRole="ResizeE" />
      <Border Grid.Row="2" Grid.Column="0" Background="Transparent" WindowDecorationProperties.ElementRole="ResizeSW" />
      <Border Grid.Row="2" Grid.Column="1" Background="Transparent" WindowDecorationProperties.ElementRole="ResizeS" />
      <Border Grid.Row="2" Grid.Column="2" Background="Transparent" WindowDecorationProperties.ElementRole="ResizeSE" />
    </Grid>
  </Grid>
</controls:CustomChromeWindow>